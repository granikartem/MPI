@startuml UC_2_Status
!pragma layout smetana
skinparam state {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontName Arial
}
skinparam shadowing false

title UC-2. Статусная модель заявки на перевозку

state "Draft\nЧерновик" as Draft
state "Ready\nГотов к отправке" as Ready
state "En Route\nВ пути" as EnRoute
state "Delayed\nЗадержка" as Delayed
state "Delivered\nДоставлен" as Delivered
state "Closed\nЗакрыт" as Closed #LightGreen
state "Cancelled\nОтменён" as Cancelled #MistyRose

' edge:ST001
[*] --> Draft : UC-1: заявка создана

' edge:ST002
Draft --> Ready : Укомплектовать рейс\n<Диспетчер>
' edge:ST003
Draft --> Cancelled : Отменить заявку\n<Диспетчер>

' edge:ST004
Ready --> EnRoute : Караван вышел на маршрут\n<Караван-мастер>\n[FR-10: обязательные роли\nкоманды заполнены — UC-9]
' edge:ST005
Ready --> Cancelled : Отменить рейс до выхода\n<Диспетчер>

' edge:ST006
EnRoute --> Delayed : Зафиксировать задержку\n<Караван-мастер / Диспетчер / Система>\n[причина]
' edge:ST007
Delayed --> EnRoute : Движение возобновлено\n<Караван-мастер / Диспетчер>
' edge:ST008
EnRoute --> Delivered : Груз доставлен\n<Караван-мастер>

' edge:ST009
Delivered --> Closed : Закрыть рейс\n<Диспетчер>

' edge:ST010
Closed --> [*]
' edge:ST011
Cancelled --> [*]

note right of Delayed
  UC-19: инцидент высокой или
  критической тяжести переводит
  рейс в Delayed автоматически
  (актор Система)
end note

note bottom of Cancelled
  Отмена возможна только
  до выхода каравана
  на маршрут
end note

legend right
  Каждый переход пишется в request_status_history (FR-3)
  и в audit-журнал MongoDB (REQUEST_STATUS_CHANGED)
endlegend
@enduml
