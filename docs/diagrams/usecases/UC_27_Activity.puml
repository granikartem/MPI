@startuml UC_27_Activity
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam nodesep 75
skinparam ranksep 100
skinparam ArrowFontSize 11
skinparam usecaseBackgroundColor #F5F5F5
skinparam activityBackgroundColor #F5F5F5
top to bottom direction
title UC-27. Изменить роль пользователя

' edge:e001
(*) --> "1. Диспетчер открывает карточку пользователя своей\nорганизации." as n002
' edge:e002
n002 --> "2. Система показывает текущую роль и допустимые варианты." as n003
' edge:e003
n003 --> "3. Диспетчер выбирает новую роль." as n004
' edge:e004
n004 --> "4. Система проверяет полномочия и допустимость изменения роли." as n005
' edge:e007
n005 --> if "Результат проверки смены роли" as n009 then
endif
' edge:e008
n009 -->[Чужая организация / недопустимая роль] "4а. Выбран чужой пользователь или недопустимая роль — система\nотклоняет действие → завершение без изменения роли." as n010
' edge:e009
n010 --> (*1)
' edge:e010
n009 -->[Последний активный диспетчер] "4б. Смена роли лишит организацию последнего активного\nдиспетчера — система отклоняет действие → завершение без\nизменения роли." as n011
' edge:e011
n011 --> (*1)
' edge:e012
n009 -->[Изменение допустимо] if "Подтвердить смену роли?" as n012 then
endif
' edge:e013
n012 -->[Да] "5. Диспетчер подтверждает изменение." as n006
' edge:e005
n006 --> "6. Система сохраняет новую роль и фиксирует автора, время и\nизменение в аудите." as n007
' edge:e006
n007 --> (*1)
' edge:e014
n012 -->[Нет: отмена] "5а. Диспетчер отменяет изменение → завершение с прежней ролью." as n013
' edge:e015
n013 --> (*1)
@enduml
