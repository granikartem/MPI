@startuml UC_1_Detail
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam nodesep 75
skinparam ranksep 100
skinparam ArrowFontSize 11
skinparam usecaseBackgroundColor #F5F5F5
skinparam activityBackgroundColor #F5F5F5
top to bottom direction
title UC-1. Создать заявку на перевозку

actor "Диспетчер караванов" as Dispatcher
rectangle "ИС «Караваны»" as SystemBoundary {
  usecase "UC-1. Создать заявку на перевозку" as UC1
  usecase "UC-5. Выбрать/спланировать маршрут" as UC5
  usecase "UC-6. Рассчитать ETA" as UC6
  usecase "UC-7. Рассчитать risk_score" as UC7
  usecase "UC-8. Получить рекомендацию по\nохране и припасам" as UC8
  usecase "UC-12. Указать ценность груза" as UC12
  usecase "UC-1.1. Ввести параметры перевозки и\nгруза" as UC1_1
  usecase "UC-1.2. Проверить обязательные поля\nи подтвердить создание" as UC1_2
  usecase "UC-1.3. Сохранить заявку, историю и\nзапись аудита" as UC1_3
  usecase "UC-1.4. Исправить ошибки\nобязательных полей" as UC1_4
}
' edge:R057
UC1 ..> UC5 : <<include>>
' edge:R058
UC1 ..> UC6 : <<include>>
' edge:R059
UC1 ..> UC7 : <<include>>
' edge:R060
UC1 ..> UC8 : <<include>>
' edge:R061
UC1 ..> UC12 : <<include>>
' edge:R062
UC7 ..> UC8 : <<include>>
' edge:R101
UC1 ..> UC1_1 : <<include>>
' edge:R102
UC1 ..> UC1_2 : <<include>>
' edge:R103
UC1 ..> UC1_3 : <<include>>
' edge:R104
UC1_4 ..> UC1 : <<extend>>
' edge:R001
Dispatcher --> UC1
' edge:R005
Dispatcher --> UC5
' edge:R007
Dispatcher --> UC7
' edge:R008
Dispatcher --> UC8
' edge:R011
Dispatcher --> UC12
legend bottom
  Части основного потока (include):
  UC-1.1 — Ввести параметры перевозки и груза (шаг 2).
  UC-1.2 — Проверить обязательные поля и подтвердить создание (шаг 8).
  UC-1.3 — Сохранить заявку, историю и запись аудита (шаг 9).
  Точки расширения и условия:
  UC-1.4 → UC-1 / EP-1: Проверка выявила незаполненные или неверные поля (альт. 8б).
  UC-6 выполняется системой внутри UC-1 и не имеет собственного актёра-инициатора.
endlegend
@enduml
