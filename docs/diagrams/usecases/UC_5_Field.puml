@startuml UC_5_Field
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam nodesep 75
skinparam ranksep 100
skinparam ArrowFontSize 11
skinparam usecaseBackgroundColor #F5F5F5
skinparam activityBackgroundColor #F5F5F5
top to bottom direction
title Полевые операции

actor "Диспетчер караванов" as Dispatcher
actor "Караван-мастер" as CaravanMaster
actor "Капитан охраны" as SecurityCaptain
actor "Полевой медик" as Medic
actor "Полевой пользователь" as FieldUser <<abstract>>
actor "NCR Checkpoint & Tax\nTerminal" as NCR <<external>>
rectangle "ИС «Караваны»" as SystemBoundary {
  usecase "UC-14. Подтвердить доставку груза (с\nпломбой)" as UC14
  usecase "UC-16. Зафиксировать прохождение\nэтапа рейса" as UC16
  usecase "UC-17. Отметить прохождение\nконтрольной точки" as UC17
  usecase "UC-18. Отметить прохождение КПП (с\nпошлиной)" as UC18
  usecase "UC-19. Сообщить об инциденте в рейсе" as UC19
  usecase "UC-20. Инициировать RecoveryRequest" as UC20
  usecase "UC-24. Получить данные о КПП и\nпошлинах" as UC24
}
' edge:R065
UC18 ..> UC24 : <<include>>
' edge:R066
UC17 ..> UC16 : <<extend>>
' edge:R067
UC18 ..> UC16 : <<extend>>
' edge:R068
UC14 ..> UC16 : <<extend>>
' edge:R069
UC20 ..> UC19 : <<extend>>
' edge:R012
Dispatcher --> UC20
' edge:R024
CaravanMaster --> UC14
' edge:R026
CaravanMaster --> UC16
' edge:R027
CaravanMaster --> UC17
' edge:R028
CaravanMaster --> UC18
' edge:R029
CaravanMaster --> UC20
' edge:R030
CaravanMaster --> UC24
' edge:R049
FieldUser --> UC19
' edge:R052
NCR --> UC18
' edge:R053
NCR --> UC24
' edge:R072
Dispatcher --> UC19
' edge:R054
CaravanMaster --|> FieldUser
' edge:R055
SecurityCaptain --|> FieldUser
' edge:R056
Medic --|> FieldUser
legend bottom
  Точки расширения и условия:
  UC17 → UC16 / EP-1: Выбрано событие прибытия на контрольную точку маршрута.
  UC18 → UC16 / EP-2: Выбрано событие прохождения КПП с фиксацией пошлины.
  UC14 → UC16 / EP-3: Выбрано событие выдачи груза получателю.
  UC20 → UC19 / EP-1: Инцидент высокой или критической тяжести зарегистрирован; диспетчер или караван-мастер
  решил инициировать реагирование.
endlegend
@enduml
