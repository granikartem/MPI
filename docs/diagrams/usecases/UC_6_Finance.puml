@startuml UC_6_Finance
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam nodesep 75
skinparam ranksep 100
skinparam ArrowFontSize 11
skinparam usecaseBackgroundColor #F5F5F5
skinparam activityBackgroundColor #F5F5F5
top to bottom direction
title Финансы и интеграции

actor "Диспетчер караванов" as Dispatcher
actor "Караван-мастер" as CaravanMaster
actor "Wasteland Intel" as WI <<external>>
actor "NCR Checkpoint & Tax\nTerminal" as NCR <<external>>
rectangle "ИС «Караваны»" as SystemBoundary {
  usecase "UC-7. Рассчитать risk_score" as UC7
  usecase "UC-18. Отметить прохождение КПП (с\nпошлиной)" as UC18
  usecase "UC-21. Сформировать финансовый отчёт\nпо рейсу" as UC21
  usecase "UC-22. Экспортировать отчёт на\nголотейп" as UC22
  usecase "UC-23. Получить данные об угрозах" as UC23
  usecase "UC-24. Получить данные о КПП и\nпошлинах" as UC24
}
' edge:R063
UC7 ..> UC23 : <<include>>
' edge:R065
UC18 ..> UC24 : <<include>>
' edge:R007
Dispatcher --> UC7
' edge:R013
Dispatcher --> UC21
' edge:R014
Dispatcher --> UC22
' edge:R015
Dispatcher --> UC23
' edge:R028
CaravanMaster --> UC18
' edge:R030
CaravanMaster --> UC24
' edge:R050
WI --> UC7
' edge:R051
WI --> UC23
' edge:R052
NCR --> UC18
' edge:R053
NCR --> UC24
@enduml
