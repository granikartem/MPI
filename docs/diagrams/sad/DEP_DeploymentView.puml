@startuml DEP_DeploymentView
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #333333
skinparam node {
  BackgroundColor #F5F5F5
  BorderColor #333333
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #333333
}

title ИС «Караваны» — Deployment Diagram (Deployment View)\nГде развёртывается каждый компонент, характеристики машин и интерфейсы взаимодействия

' ─── Центральный сервер ──────────────────────────────────────────────
node "**Центральный сервер караванной конторы** <<device>>\nCPU: Intel Xeon E5-2643, 16 ядер, 3,3 ГГц, x64\nRAM: 128 ГБ · диски: 26 ТБ · сеть: Ethernet 10 Гбит/с · ИБП: рекомендуется" as SRV {

  node "**FreeBSD 14.3-STABLE** <<execution environment>>\nZFS-пул (отдельные датасеты под данные PostgreSQL, MongoDB и резервные копии)\nсетевой фильтр pf: извне открыт только TCP 443 · службы запускаются через rc.d" as OS #EEEEEE {

    node "**nginx 1.30** <<execution environment>>\nпакет www/nginx · служба nginx · TLS на :443" as NGINX {
      artifact "web-клиент и PWA\n/usr/local/www/karavany\n(сборка vite build)" as A_WEB
      artifact "конфигурация сайта\nTLS, прокси /api/* → 127.0.0.1:8080" as A_NGINX_CONF
    }

    node "**OpenJDK 21** <<execution environment>>\nпакет java/openjdk21 · служба karavany · слушает 127.0.0.1:8080" as JVM {
      artifact "karavany-0.1.0.jar\nSpring Boot 3.3, миграции Flyway" as A_JAR
    }

    node "**PostgreSQL 16** <<execution environment>>\nпакет databases/postgresql16-server\nслужба postgresql · слушает 127.0.0.1:5432" as PG {
      database "БД karavany\nоперативные данные" as DB_PG
    }

    node "**MongoDB 7.0** <<execution environment>>\nпакет databases/mongodb70\nслужба mongod · слушает 127.0.0.1:27017" as MONGO {
      database "БД karavany\nснимки риска, аудит, события" as DB_MONGO
    }

    artifact "Резервные копии\npg_dump, mongodump,\nZFS-снапшоты датасетов" as A_BACKUP
  }
}

node "**Резервная кассета (голотейп)** <<device>>\nнакопитель, подключённый к серверу" as HOLO

' ─── Клиентские устройства ───────────────────────────────────────────
node "**Офисный терминал** <<device>> × до 50\nCPU 2 ядра 1,5 ГГц · RAM 8 ГБ · экран от 1024×768\nОС: Windows 10 / macOS 11 / Ubuntu 20.04+\nсеть: LAN или Wi-Fi, 10 Мбит/с" as TERM {
  node "Браузер Chrome / Firefox / Opera\n<<execution environment>>" as BROWSER {
    artifact "web-клиент ИС «Караваны»\nдиспетчер, кладовщик, суперпользователь" as A_WEB_RUN
  }
}

node "**Pip-Boy 3000 или совместимое устройство** <<device>> × до 150\nARM 1,0 ГГц · RAM 1 ГБ · экран от 256×128 · хранилище 64 ГБ\nWi-Fi 802.11 b/g/n, 10 Мбит/с · автономность ≥ 72 ч" as PIP {
  node "Браузер устройства\n<<execution environment>>" as PIP_BROWSER {
    artifact "PWA полевого клиента\nкараван-мастер, капитан охраны, медик" as A_PWA
    database "IndexedDB: очередь\nсобытий без связи ≥ 3 ч" as PIP_STORE
  }
}

' ─── Внешние системы ─────────────────────────────────────────────────
node "**Wasteland Intel** <<external system>>\nданные об угрозах по участкам" as WI #EDE7F6
node "**NCR Checkpoint & Tax Terminal** <<external system>>\nпрохождение КПП и пошлины" as NCR #EDE7F6

' ─── Интерфейсы взаимодействия ───────────────────────────────────────
BROWSER --> NGINX : HTTPS :443\nстатика + REST / JSON
PIP_BROWSER --> NGINX : HTTPS :443, REST / JSON\nсинхронизация при появлении связи (≤ 60 с, RL-3)
NGINX --> JVM : HTTP, 127.0.0.1:8080\n/api/*
JVM --> PG : JDBC (PostgreSQL wire)\n127.0.0.1:5432
JVM --> MONGO : MongoDB Wire Protocol\n127.0.0.1:27017
JVM --> WI : REST / HTTPS :443, JSON\nGET /threats?segments=…\nconnect / read timeout 2 с
JVM --> NCR : REST / HTTPS :443, JSON\n(UC-24)
PG ..> A_BACKUP : pg_dump
MONGO ..> A_BACKUP : mongodump
A_BACKUP --> HOLO : запись резервной копии
TERM ..> PIP : установка PWA через RobCo-интерфейс\nтерминала или с голотейпа (Vision 4.5)

note right of OS
  **Размещение на сервере.** Все компоненты работают
  в одной ОС как отдельные службы rc.d под своими
  системными пользователями. Наружу через pf доступен
  только nginx на :443; backend, PostgreSQL и MongoDB
  слушают только loopback-интерфейс 127.0.0.1.
  **Поставка артефактов.** karavany-0.1.0.jar собирается
  gradle bootJar (JDK 21), web-клиент — npm run build;
  на сервер копируются готовые файлы.
  **MongoDB.** Порт databases/mongodb70 содержит
  FreeBSD-специфичный патч, не проходивший QA MongoDB Inc.,
  поэтому перед вводом в эксплуатацию — нагрузочная
  проверка (PF-1…PF-3). AVX процессор поддерживает.
end note

legend right
  |= Цвет |= Значение |
  | <#F5F5F5> | устройство или среда выполнения |
  | <#FFFFFF> | артефакт |
  | <#E8F5E9> | хранилище данных |
  | <#EDE7F6> | внешняя система |
  **Характеристики** сервера, терминала и Pip-Boy — Vision 9.2;
  число устройств — Vision 9.3 и PF-1 (50 терминалов + 150 Pip-Boy).
  Разрешение терминала: Vision 9.2 — от 1024×768, глоссарий — от 1280×720.
  **Интерфейсы:** клиент — сервер только HTTPS (SRS 3.6.4),
  внешние системы — REST по HTTPS, формат JSON.
endlegend
@enduml
