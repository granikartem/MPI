@startuml SEQ_UC32_LogicalView
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #F5F5F5
skinparam ParticipantBorderColor #333333
skinparam ActorBackgroundColor #F5F5F5
skinparam BoxPadding 8
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #8D6E63

title UC-32 «Создать организацию» — Sequence Diagram (Logical View)\nВзаимодействие логических компонентов; уровни совпадают с диаграммой пакетов

actor "Суперпользователь" as SU

box "presentation" #FDFDFD
  participant "Интерфейс управления\nорганизациями" as PRES
end box

box "application" #FDFDFD
  participant "Создание организации\nUC-32" as APP
end box

box "domain" #E8F5E9
  participant "Организация" as ORG
  participant "Учётная запись" as USR
  participant "Событие аудита" as EVT
end box

box "infrastructure" #E3F2FD
  participant "Хранение данных" as STORE
  participant "Журнал аудита" as AUDIT
end box

SU -> PRES : 1: заполнить данные организации\nи первого диспетчера, подтвердить
activate PRES
PRES -> APP : 1.1: результат = создатьОрганизацию(данные организации,\nданные первого диспетчера)
activate APP

group одна транзакция слоя application\nшаги 1.1.1…1.1.8 фиксируются целиком или не фиксируются вовсе

  APP -> STORE : 1.1.1: занято = найти организацию по названию
  break название занято (альт. 4а)
    note over APP : не фиксируется ничего: доменный объект\nне создан, в хранилище записи нет
    PRES ->> SU : 1.2: показать ошибку «Организация\nс таким названием уже существует»
  end

  opt первый диспетчер задан
    APP -> STORE : 1.1.2: занят = найти пользователя по логину
    break логин занят
      note over APP : не фиксируется ничего: доменный объект\nне создан, в хранилище записи нет
      PRES ->> SU : 1.3: показать ошибку «Пользователь\nс таким логином уже существует»
    end
  end

  create ORG
  APP -> ORG : 1.1.3: организация = создать(ключ арендатора,\nназвание, уровень подписки, контакты)
  note over ORG : домен: объект существует,\nв хранилище записи ещё нет
  APP -> STORE : 1.1.4: сохранить организацию
  note over STORE : хранилище: запись существует,\nдомен и хранилище согласованы

  alt первый диспетчер задан
    create USR
    APP -> USR : 1.1.5: учётная запись = создать(организация,\nФИО, логин, хеш начального пароля,\nроль «Диспетчер»)
    note over USR : домен: объект существует,\nв хранилище записи ещё нет
    APP -> STORE : 1.1.6: сохранить учётную запись
    note over STORE : хранилище: запись существует,\nдомен и хранилище согласованы
  else альт. 6а: назначение пропущено
    note over APP : организация создаётся без пользователей,\nдиспетчер назначается позже (UC-33)
  end

  create EVT
  APP -> EVT : 1.1.7: событие = сформировать\n«организация создана»
  note over EVT : домен: объект существует,\nв хранилище записи ещё нет
  APP -> AUDIT : 1.1.8: записать событие
  note over AUDIT : хранилище: запись существует,\nдомен и хранилище согласованы

end
deactivate APP

PRES ->> SU : 1.4: показать организацию в реестре,\nключ арендатора и логин диспетчера
deactivate PRES

legend right
  Нумерация иерархическая: целое число — действие актора,
  вложенные вызовы — 1.1, 1.1.1, …; ответы актору — 1.2, 1.3, 1.4.
  Сплошная линия, закрашенная стрелка — синхронный вызов;
  результат вызова — в подписи: «результат = операция(...)».
  Сплошная линия, открытая стрелка — асинхронное сообщение.
  Ответные сообщения (пунктир) не рисуются.
  |= Зона |= Значение |
  | <#E8F5E9> | **domain** — состояние домена: объект живёт в памяти слоя |
  | <#E3F2FD> | **infrastructure** — состояние хранения: запись в хранилище |
  Участник слоя domain появляется на диаграмме в момент создания
  (конструкция «create»), а не с самого верха: до этого доменного
  объекта не существует. Заметки фиксируют инвариант на каждом шаге.
endlegend
@enduml
