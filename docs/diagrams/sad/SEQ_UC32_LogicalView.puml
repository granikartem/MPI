@startuml SEQ_UC32_LogicalView
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #F5F5F5
skinparam ParticipantBorderColor #333333
skinparam ActorBackgroundColor #F5F5F5
skinparam BoxPadding 8

title UC-32 «Создать организацию» — Sequence Diagram (Logical View)\nВзаимодействие логических компонентов; уровни совпадают с диаграммой пакетов

actor "Суперпользователь" as SU

box "presentation" #FDFDFD
  participant "Интерфейс управления\nорганизациями" as PRES
end box

box "application" #FDFDFD
  participant "Создание организации\n(UC-32)" as APP
end box

box "domain" #FDFDFD
  participant "Организация" as ORG
  participant "Учётная запись" as USR
  participant "Событие аудита" as EVT
end box

box "infrastructure" #FDFDFD
  participant "Хранение\nданных" as STORE
  participant "Журнал\nаудита" as AUDIT
end box

SU -> PRES : 1: заполнить данные организации\nи первого диспетчера, подтвердить
activate PRES
PRES -> APP : 1.1: результат = создатьОрганизацию(данные организации,\nданные первого диспетчера)
activate APP

APP -> STORE : 1.1.1: занято = найти организацию по названию
break название занято (альт. 4а)
  PRES ->> SU : 1.2: показать ошибку «Организация\nс таким названием уже существует»
end

opt первый диспетчер задан
  APP -> STORE : 1.1.2: занят = найти пользователя по логину
  break логин занят
    PRES ->> SU : 1.2: показать ошибку «Пользователь\nс таким логином уже существует»
  end
end

APP -> ORG : 1.1.3: организация = создать(ключ арендатора, название,\nуровень подписки, контакты)
APP -> STORE : 1.1.4: сохранить организацию

alt первый диспетчер задан
  APP -> USR : 1.1.5: учётная запись = создать(организация, ФИО, логин,\nхеш начального пароля, роль «Диспетчер»)
  APP -> STORE : 1.1.6: сохранить учётную запись
else альт. 6а: назначение пропущено
  note over APP : организация создаётся без пользователей,\nдиспетчер назначается позже (UC-33)
end

APP -> EVT : 1.1.7: событие = сформировать «организация создана»
APP -> AUDIT : 1.1.8: записать событие
deactivate APP

PRES ->> SU : 1.2: показать организацию в реестре,\nключ арендатора и логин диспетчера
deactivate PRES

legend right
  Нумерация иерархическая: целое число — действие актора,
  вложенные вызовы — 1.1, 1.1.1, …
  Сплошная линия, закрашенная стрелка — синхронный вызов;
  результат вызова — в подписи: «результат = операция(...)».
  Сплошная линия, открытая стрелка — асинхронное сообщение.
endlegend
@enduml
