@startuml SM_UC1_LogicalView
' Раскладка — Graphviz (без !pragma layout smetana): smetana уводит обратные
' переходы «сбросить оценку» за правую рамку подсистемы «Оценка риска».
skinparam shadowing false
skinparam state {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontName Arial
}

title UC-1 «Создать заявку на перевозку» — State Machine Diagram (Logical View)\nСостояния двух подсистем слоя application — «Создание заявки» (UC-1) и «Оценка риска» (UC-7, UC-8); имена подсистем — по диаграмме пакетов

state "application · Создание заявки\nUC-1" as A_REQ {

  state "Ожидание команды" as Idle
  Idle : подсистема не ведёт обработку:\nтранзакция не открыта, заявка не создана

  state "Проверка организации" as OrgCheck
  state "Подготовка маршрута" as RoutePrep
  state "Расчёт ETA" as EtaCalc
  state "Запрос оценки риска" as RiskReq
  state "Фиксация заявки" as Persist #LightGreen
  state "Откат команды" as Rollback #MistyRose
  Rollback : Хранение данных: откат транзакции —\nни заявка, ни маршрут альт. 3а\nв хранилище не появились;\nпричина отказа уходит диспетчеру\n(организация не указана или не найдена;\nмаршрут или контрольная точка не найдены)

  [*] --> Idle
  Idle --> OrgCheck : получена команда\nсоздания заявки
  OrgCheck --> Rollback : [организация\nне найдена]
  OrgCheck --> RoutePrep : [организация найдена]\n/ Хранение данных: прочитать организацию
  RoutePrep --> Rollback : [маршрут или точка\nне найдены]
  RoutePrep --> EtaCalc : [выбран шаблон маршрута]\n/ Хранение данных: прочитать маршрут
  RoutePrep --> EtaCalc : [участки заданы вручную] (альт. 3а)\n/ Маршрут: собрать из участков;\nХранение данных: сохранить маршрут и участки
  EtaCalc --> RiskReq : / Расчёт ETA:\nдлина маршрута / 4 км/ч
  RiskReq --> Persist : режим оценки получен\n/ Заявка: risk_score и рекомендация\nпо охране и припасам
  Persist --> [*] : / Заявка: статус Draft;\nХранение данных: сохранить заявку;\nИстория статусов: запись «— → Draft»
  Rollback --> [*]
}

state "application · Оценка риска\nUC-7, UC-8" as A_RISK {

  state "Оценка не запрошена\n(NA, снимка нет)" as NoRisk
  NoRisk : risk_status = NA, risk_score пуст,\nрекомендации нет; в Хранении снимков\nриска снимков по заявке нет

  state Calc <<choice>>

  state "Снимок оценки сохранён" as Snap {
    state "Оценка получена" as RiskOk #LightGreen
    RiskOk : risk_status = OK, risk_score\nи рекомендация по охране и припасам

    state "Оценка устарела" as RiskStale #LightYellow
    RiskStale : risk_status = STALE, risk_score\nрассчитан по данным старше 24 ч

    state "Оценка не получена\n(NA, снимок с пометкой)" as RiskNa #MistyRose
    RiskNa : risk_status = NA, risk_score пуст,\nно снимок сохранён с рекомендацией\n«требует пересчёта»
  }
  Snap : entry / сохранить снимок

  [*] --> NoRisk
  NoRisk -down-> Calc : запрос оценки по маршруту\nи ценности груза\n/ Адаптер Wasteland Intel:\nзапросить отчёт об угрозах
  Calc --> RiskOk : [отчёт получен,\nданные актуальны]
  Calc --> RiskStale : [дата актуальности\nстарше 24 ч]\n(альт. 2б UC-7)
  Calc --> RiskNa : [отчёта нет: таймаут 2 с\nили ошибка источника]\n(альт. 4а UC-1, альт. 2а UC-7)
  Snap -up-> Calc : повторить расчёт
  ' пробелы по краям средней строки — отступ подписи от линии перехода (иначе «/» ложится на неё)
  Snap -up-> NoRisk : сбросить оценку\n   / Хранение снимков риска:   \nудалить снимки
}

A_REQ -[#0057B8,dashed]-> A_RISK
note on link
  запрос оценки:
  маршрут и ценность груза
end note
A_RISK -[#0057B8,dashed]-> A_REQ
note on link
  ответ: режим оценки
  и рекомендация
end note

legend right
  Показаны состояния ДВУХ подсистем слоя application, а не статусы
  одной заявки: «Создание заявки UC-1» ведёт обработку команды,
  «Оценка риска UC-7, UC-8» хранит режим оценки маршрута.
  Синие связи — обращение одной подсистемы к другой: «Создание
  заявки» в состоянии «Запрос оценки риска» передаёт маршрут
  и ценность груза, «Оценка риска» возвращает режим и рекомендацию.
  Подпись перехода: событие [сторожевое условие] / эффект.
  Ромб — выбор по результату отчёта об угрозах. Любой исход сохраняет
  снимок в «Хранении снимков риска», поэтому сохранение снимка —
  входное действие рамки «Снимок оценки сохранён»; переходы
  «повторить расчёт» и «сбросить оценку» проведены от этой рамки:
  они возможны из любого её состояния, и повтор расчёта может дать
  любой из трёх исходов.
  Оба состояния с пометкой NA дают заявке один и тот же признак
  risk_status = NA; различает их снимок в Хранении снимков риска:
  после сброса снимков нет, после отказа источника снимок сохранён.
  Отмена создания диспетчером (альт. 8а UC-1) событием этой машины
  не является: команда в слой application не отправляется и
  «Создание заявки» остаётся в состоянии «Ожидание команды».
  В эффектах названы логические компоненты диаграммы пакетов:
  application — Расчёт ETA; domain — Заявка, Маршрут,
  История статусов; infrastructure — Хранение данных,
  Хранение снимков риска, Адаптер Wasteland Intel.
  Статус Draft — эффект перехода «фиксация заявки»; переходы между
  статусами заявки описывает Статусная модель (диаграмма UC-2).
  Запись события создания в Журнал аудита предусмотрена
  спецификацией UC-1 (шаг 9), в текущей реализации отсутствует,
  поэтому на диаграмме не показана.
endlegend
@enduml
