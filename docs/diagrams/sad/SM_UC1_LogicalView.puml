@startuml SM_UC1_LogicalView
!pragma layout smetana
skinparam shadowing false
skinparam state {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontName Arial
}

title UC-1 «Создать заявку на перевозку» — State Machine Diagram (Logical View)\nЖизненный цикл доменного объекта «Заявка» в рамках UC-1; эффекты переходов выполняют компоненты слоёв диаграммы пакетов

state "Заявка на перевозку (domain)" as Request {

  state "Заполняется" as Filling
  Filling : данные формы ещё не переданы\nв слой application

  state "Формируется" as Forming {
    state "Организация\nподтверждена" as OrgOk
    state "Маршрут определён" as Routed
    state "ETA рассчитано" as Eta
    state "Риск оценён\n(OK или STALE)" as Assessed
    state "Риск требует\nпересчёта (NA)" as NeedsRecalc

    [*] --> OrgOk : [организация существует]\n/ Хранение данных: найти организацию
    OrgOk --> Routed : [выбран шаблон]\n/ Хранение данных: прочитать шаблон маршрута
    OrgOk --> Routed : [заданы участки] (альт. 3а)\n/ Маршрут: собрать из участков;\nХранение данных: сохранить маршрут
    Routed --> Eta : / Расчёт ETA: длина маршрута / 4 км/ч
    Eta --> Assessed : [Wasteland Intel ответил]\n/ Оценка риска через Адаптер Wasteland Intel:\nrisk_score и рекомендация по охране и припасам
    Eta --> NeedsRecalc : [Wasteland Intel недоступен] (альт. 4а)\n/ Оценка риска: risk_score = Н/Д
  }

  state "Черновик (Draft)" as Draft #LightGreen
  Draft : заявка сохранена в хранилище

  state "Статусная модель заявки (UC-2)" as UC2 <<вложенная машина состояний>>
  UC2 : Draft → Ready → En Route → … → Closed

  state "Создание отменено" as Cancelled #MistyRose
  Cancelled : заявка в хранилище не появилась

  [*] --> Filling : диспетчер открыл форму\n(Интерфейс заявок)
  Filling --> Forming : подтвердить создание\n/ Интерфейс заявок → Создание заявки
  Filling --> Cancelled : отменить создание (альт. 8а)\n/ данные формы отброшены
  Forming --> Filling : [организация, шаблон маршрута\nили контрольная точка не найдены]\n/ откат транзакции, показать причину отказа
  Assessed --> Draft : / Заявка: статус «Черновик»;\nХранение данных: сохранить заявку, снимок риска\nи запись истории «— → Черновик»
  NeedsRecalc --> Draft : / то же, с пометкой\n«требует пересчёта risk_score»
  Draft --> UC2 : прецедент UC-1 завершён —\nдальнейшими переходами управляет UC-2
  UC2 --> [*] : рейс закрыт или отменён (UC-2)
  Cancelled --> [*]
}

legend right
  Диаграмма описывает жизненный цикл одного доменного объекта,
  поэтому все состояния лежат внутри «Заявка на перевозку (domain)»:
  «Формируется» — вложенное композитное состояние,
  «Статусная модель заявки (UC-2)» — вложенная машина состояний,
  которой заявка передаётся после сохранения (раскрыта на диаграммах UC-2).
  Два исхода UC-1: «Черновик» — заявка создана, «Создание отменено» —
  заявка в системе не появилась; оба ведут в завершающее состояние.
  Подпись перехода: событие [сторожевое условие] / эффект.
  В эффекте указан логический компонент диаграммы пакетов:
  presentation — Интерфейс заявок; application — Создание заявки,
  Расчёт ETA, Оценка риска; domain — Заявка, Маршрут;
  infrastructure — Хранение данных, Адаптер Wasteland Intel.
endlegend
@enduml
