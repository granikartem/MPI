@startuml COL_UC1_ImplementationView
!pragma layout smetana
set separator none
skinparam shadowing false
skinparam objectBackgroundColor #F5F5F5
skinparam objectBorderColor #333333
skinparam packageStyle rectangle
skinparam ArrowColor #333333
skinparam defaultFontName Courier

title UC-1 «Создать заявку на перевозку» — Cooperative (Communication) Diagram (Implementation View)\nОбъекты реализации: классы, вызываемые методы, запросы к хранилищам и внешней системе

object "d:Диспетчер" as D <<actor>> #White

package "frontend/src: pages, components\n(React 18 + TypeScript)" {
  object "form:RequestForm.tsx" as FORM
  object "console:Console.tsx" as CON
  object "reg:RequestRegistry.tsx" as REG
}

' api.ts лежит в корне frontend/src и показан отдельным пакетом:
' внутри одного пакета метка шага 1.1 ложилась на рамку
package "frontend/src" {
  object "api:api.ts — клиент REST (axios)" as API
}

package "com.karavany.request" {
  object "c:RequestController" as WEB <<@RestController>>
  object "s:RequestService" as SVC <<@Service>>
  object "eta:EtaService" as ETA <<@Service>>
  object "st:RequestStatusService" as ST <<@Service>>
  object "repo:CaravanRequestRepository" as REPO <<JpaRepository>>
  object "hRepo:RequestStatusHistoryRepository" as HREPO <<JpaRepository>>
}

package "com.karavany.organization" {
  object "orgRepo:OrganizationRepository" as OREPO <<JpaRepository>>
}

package "com.karavany.route" {
  object "routeRepo:RouteRepository" as RREPO <<JpaRepository>>
  object "cpRepo:CheckpointRepository" as CPREPO <<JpaRepository>>
  object "segRepo:RouteSegmentRepository" as SREPO <<JpaRepository>>
  object "route:Route" as ROUTE <<@Entity>>
}

package "com.karavany.risk" {
  object "risk:RiskService" as RISK <<@Service>>
  object "intel:WastelandIntelClient" as INTEL <<@Component>>
  object "raRepo:RiskAssessmentRepository" as RAREPO <<MongoRepository>>
}

package "внешние системы" {
  object "wi:Wasteland Intel" as WI <<внешняя система>>
}

D -right-> FORM : 1: submit(e: FormEvent)
FORM --> API : 1.1: created =\ncreateRequest(\nbody: CreateRequestBody)
API --> WEB : 1.1.1: POST /api/requests : HTTP 201 | 400
WEB --> SVC : 1.1.1.1 [routeId != null]: create(organizationId,\norigin, destination, departureDate,\ncargoDescription, cargoValueCaps, routeId)\n1.1.1.1 [segments не пуст]:\ncreateWithManualRoute(..., routeName, specs)
SVC --> OREPO : 1.1.1.1.1: findById(organizationId) : Optional<Organization>
SVC --> RREPO : 1.1.1.1.2 [шаблон]: findById(routeId)\n: Optional<Route>\n1.1.1.1.2 [ручной]:\nsave(new Route(nextRouteCode(), name, false))
SVC --> CPREPO : 1.1.1.1.3 [ручной] *[для каждого участка]:\nfindByCode(code) : Optional<Checkpoint>
SVC --> SREPO : 1.1.1.1.4 [ручной]: saveAll(segments)
SVC --> ETA : 1.1.1.1.5: etaHours = computeHours(route)
ETA --> ROUTE : 1.1.1.1.5.1: getSegments() : List<RouteSegment>\n[шаблон] ленивая загрузка связи Route.segments провайдером JPA:\nSELECT из route_segment WHERE route_id = ? ORDER BY ord
SVC --> RISK : 1.1.1.1.6: risk = calculate(route, cargoValueCaps)\n1.1.1.1.8: saveAssessment(saved.getId(), risk)
RISK --> INTEL : 1.1.1.1.6.1: report = fetchThreats(segmentKeys)
INTEL --> WI : 1.1.1.1.6.1.1: GET /threats?segments=…\n(connect / read timeout 2000 мс)
SVC --> REPO : 1.1.1.1.7: saved = save(request) — INSERT в caravan_request, status = DRAFT
RISK --> RAREPO : 1.1.1.1.8.1: save(new RiskAssessment(requestId, risk, now))
SVC --> ST : 1.1.1.1.9: recordCreation(saved)
ST --> HREPO : 1.1.1.1.9.1: save(new RequestStatusHistory(saved, null,\nDRAFT, DISPATCHER, null, "Заявка создана"))
FORM --> CON : 1.2: onCreated(created)
CON --> REG : 1.2.1: setCreated(n + 1)\n→ prop reloadToken
REG --> API : 1.2.1.1 (асинхронно): load() = getRegistry(organizationId, query)\nGET /api/requests/registry

' ─── раскладка (скрытые связи, на смысл диаграммы не влияют) ───────────
' repo ставится справа от сервиса: иначе s:RequestService — крайний правый
' объект пакета, и многострочная метка шага 1.1.1.1 ложится на его рамку
SVC -[hidden]right-> REPO
' пакет «внешние системы» — под com.karavany.risk, чтобы стрелка 1.1.1.1.6.1.1
' входила в него сбоку, а не сквозь заголовок пакета
RAREPO -[hidden]down-> WI

note as N_STORAGE
  **Куда идут обращения к хранилищам**
  Сами СУБД объектами взаимодействия не показаны: к PostgreSQL
  обращаются репозитории Spring Data и — на шаге 1.1.1.1.5.1 —
  ленивая загрузка связи Route.segments провайдером JPA.
  **PostgreSQL 16 (@Entity, JpaRepository):**
  orgRepo → organization (SELECT), routeRepo → route (SELECT | INSERT),
  cpRepo → checkpoint (SELECT), repo → caravan_request (INSERT),
  hRepo → request_status_history (INSERT);
  route_segment — SELECT ленивой загрузкой Route.segments,
  INSERT через segRepo.saveAll (только ручной маршрут).
  **MongoDB 7 (@Document, MongoRepository):**
  raRepo → коллекция risk_assessment (insertOne).
  На шаге 1.1.1.1.6 RiskService берёт ключи участков из уже
  загруженной коллекции — повторный SELECT не выполняется.
  Состав таблиц, колонок и индексов — на DB_ER_ImplementationView
  и DB_Datalogical_ImplementationView.
end note

' заметка о хранилищах — под актёром: иначе она встаёт между d:Диспетчер
' и пакетом, и стрелка 1 обходит её поверх заголовка пакета
D -[hidden]down-> N_STORAGE

note bottom of SVC
  **Граница транзакции — в слое web:** @Transactional стоит
  на RequestController.create(), поэтому все обращения к PostgreSQL
  на шагах 1.1.1.1.1–1.1.1.1.9.1 идут в одной транзакции.
  Единственная запись этого диапазона вне неё — 1.1.1.1.8.1:
  MongoDB транзакцией не охвачена, запись при откате не отменяется.
  [не указаны ни routeId, ни segments] и
  [организация, маршрут или контрольная точка не найдены] →
  IllegalArgumentException → handleBadRequest → HTTP 400,
  транзакция откатывает INSERT.
  [Wasteland Intel не ответил] → RiskResult.unavailable(): risk_status = NA
  **Событие аудита при создании заявки не пишется:** recordCreation()
  сохраняет только запись истории статусов. AuditEvent пишут
  changeStatus() (UC-2) и OrganizationService.create() (UC-32) —
  этим UC-1 и UC-32 различаются.
end note
@enduml
