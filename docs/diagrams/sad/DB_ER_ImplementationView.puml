hide empty members

title ИС «Караваны» — Data Base Diagram (Implementation View)\nЧасть 1. ER-модель: сущности, атрибуты, ключи и связи с кратностями (нотация «воронья лапка»)

' ─── Организации и доступ ────────────────────────────────────────────
package "Организации и доступ" {
  entity "Организация" as organization #F5F5F5 {
    * id <<PK>>
    --
    * ключ арендатора <<уникальный>>
    * название <<уникальное без учёта регистра>>
    * уровень подписки
    юридический адрес
    основной контакт
    канал связи
    регион
    * статус
    * момент создания
  }

  entity "Подписка" as subscription <<проект>> #FFF2CC {
    * id <<PK>>
    --
    * организация <<FK>>
    * уровень (BASIC / STANDARD / PRO)
    * начало оплаченного периода
    * окончание оплаченного периода
    * окончание grace-периода {+30 сут}
    * статус (ACTIVE / GRACE / BLOCKED)
  }

  entity "Терминал" as terminal <<проект>> #FFF2CC {
    * id <<PK>>
    --
    * организация <<FK>>
    * подписка <<FK>>
    * название
    * хеш API-ключа <<уникальный>>
    момент активации
    * статус (ACTIVE / REVOKED)
  }

  entity "Роль" as role <<проект>> #FFF2CC {
    * id <<PK>>
    --
    * код <<уникальный>>
    * название
    * область (PLATFORM / OFFICE / FIELD / SYSTEM)
    * обязательна в команде рейса
    обязательна при risk_score от
  }

  entity "Пользователь (сотрудник)" as app_user <<меняется>> #E3F2FD {
    * id <<PK>>
    --
    организация <<FK>> {не задана только у суперпользователя}
    * роль <<FK>>
    * ФИО
    * логин <<уникальный без учёта регистра>>
    * хеш пароля
    * требуется смена пароля
    канал связи
    * активен
    * момент создания
  }

  entity "Ставка сотрудника" as employee_rate <<проект>> #FFF2CC {
    * id <<PK>>
    --
    * сотрудник <<FK>>
    * оклад, крышек
    * действует с
    действует по
    * назначил <<FK>>
  }
}

' ─── Заявка и маршрут ────────────────────────────────────────────────
package "Заявка и маршрут" {
  entity "Заявка на перевозку" as caravan_request <<меняется>> #E3F2FD {
    * id <<PK>>
    --
    * организация <<FK>>
    маршрут <<FK>>
    * пункт отправления
    * пункт назначения
    * дата отправки
    описание груза
    * ценность груза, крышек
    расчётное время доставки, ч {FR-5}
    risk_score {0..100}
    * актуальность risk_score (OK / STALE / NA)
    рекомендация по охране и припасам
    * статус (7 значений статусной модели)
    * момент создания
  }

  entity "Запись истории статусов" as request_status_history <<меняется>> #E3F2FD {
    * id <<PK>>
    --
    * заявка <<FK>>
    прежний статус
    * новый статус
    * роль актора <<FK>>
    пользователь-актор <<FK>>
    имя актора
    причина
    * момент перехода
  }

  entity "План охраны и припасов" as escort_plan <<проект>> #FFF2CC {
    * заявка <<PK, FK>>
    --
    * рекомендовано охранников
    * рекомендованный уровень припасов
    принято охранников
    принятый уровень припасов
    принял <<FK>>
    момент принятия
  }

  entity "Маршрут" as route #F5F5F5 {
    * id <<PK>>
    --
    * код RT-N <<уникальный>>
    * название
    * шаблон платформы
    организация <<FK>> {для ручного маршрута}
  }

  entity "Участок маршрута" as route_segment #F5F5F5 {
    * id <<PK>>
    --
    * маршрут <<FK>>
    * порядковый номер
    * начальная точка <<FK>>
    * конечная точка <<FK>>
    * длина, км
  }

  entity "Контрольная точка" as checkpoint #F5F5F5 {
    * id <<PK>>
    --
    * код <<уникальный>>
    * название
    * является КПП НКР {проект}
  }

  entity "Снимок оценки риска" as risk_assessment <<MongoDB>> #E8F5E9 {
    * id <<PK>>
    --
    * заявка {по значению}
    score
    * статус (OK / STALE / NA)
    рекомендация
    дата актуальности данных
    * сумма уровней угроз
    * базовая оценка
    * надбавка за ценность груза
    * угрозы по участкам [список]
    * момент расчёта
  }
}

