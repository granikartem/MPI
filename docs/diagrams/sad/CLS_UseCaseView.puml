@startuml CLS_UseCaseView
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
  FontName Arial
}
skinparam enum {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontName Arial
}
hide circle
hide methods
hide empty members

title ИС «Караваны» — Class Diagram (Use-Case View)\nПонятия предметной области и связи между ними: без слоёв, классов, типов и хранилищ

' ─── Кто работает в системе ──────────────────────────────────────────
class "Организация" as ORG #F5F5F5 {
  название
  уровень подписки
  состояние
}

class "Сотрудник" as USER #F5F5F5 {
  имя
  роль в организации
  канал связи
}

' ─── Рейс ────────────────────────────────────────────────────────────
class "Заявка на перевозку" as REQ #F5F5F5 {
  пункт отправления
  пункт назначения
  желаемая дата отправки
  описание груза
  оценочная ценность груза
  расчётное время в пути
  текущий статус
}

class "Запись истории рейса" as HIST #F5F5F5 {
  предыдущий статус
  новый статус
  кто инициировал переход
  причина
  когда произошло
}

enum "Статус рейса" as STATUS #F5F5F5 {
  Черновик
  Готов к отправке
  В пути
  Задержка
  Доставлен
  Закрыт
  Отменён
}

enum "Роль участника" as ROLE #F5F5F5 {
  Диспетчер караванов
  Караван-мастер
  Система
}

' ─── Маршрут ─────────────────────────────────────────────────────────
class "Маршрут" as ROUTE #F5F5F5 {
  название
  готовый шаблон или задан вручную
}

class "Участок маршрута" as SEG #F5F5F5 {
  порядок в маршруте
  протяжённость
}

class "Контрольная точка" as CP #F5F5F5 {
  название
}

' ─── Оценка риска ────────────────────────────────────────────────────
class "Оценка риска" as RISK #F5F5F5 {
  значение риска
  актуальность оценки
  рекомендация по охране и припасам
  когда получена
}

enum "Уровень риска" as LEVEL #F5F5F5 {
  Н/Д
  Низкий
  Средний
  Высокий
  Критический
}

' ─── Внешняя система разведки ────────────────────────────────────────
class "Wasteland Intel" as WI <<внешняя система>> #EDE7F6 {
}

class "Отчёт об угрозах" as REPORT #EDE7F6 {
  дата актуальности сведений
}

class "Угроза участка" as THREAT #EDE7F6 {
  участок маршрута
  уровень опасности
  виды угроз
}

' ─── Журнал аудита ───────────────────────────────────────────────────
class "Событие аудита" as AUDIT #F5F5F5 {
  что произошло
  кто инициировал
  когда произошло
}

' ─── Полевые события рейса: этапы и инциденты (UC-16, UC-19) ────────
class "Этап рейса" as STAGE #F5F5F5 {
  порядок этапа
  вид этапа
  плановое время
  подтверждён
}

class "Отметка прохождения" as LOG #F5F5F5 {
  фактическое время
  место
  результат
  причина задержки
}

class "Инцидент" as INC #F5F5F5 {
  вид инцидента
  тяжесть
  время и место
  описание произошедшего
}

class "Участник инцидента" as PART #F5F5F5 {
  роль в инциденте
  пострадал
  состояние и оказанная помощь
}

class "Запрос на реагирование" as RECOVERY #F5F5F5 {
  что требуется
  состояние обработки
}

' ─── Связи: организация и её люди ────────────────────────────────────
ORG "1" o-- "0..*" USER : сотрудники организации
ORG "1" o-- "0..*" REQ : рейсы организации (FR-23, FR-24)

' ─── Связи: рейс и маршрут ───────────────────────────────────────────
REQ "0..*" --> "0..1" ROUTE : выполняется по маршруту (FR-4)
ROUTE "1" *-- "1..*" SEG : участки в порядке следования
SEG "0..*" --> "1" CP : начало участка
SEG "0..*" --> "1" CP : конец участка

' ─── Связи: статусная модель ─────────────────────────────────────────
REQ "1" *-- "1..*" HIST : история переходов (FR-3)
REQ ..> STATUS : текущий статус (FR-2)
HIST ..> STATUS : из какого в какой
HIST ..> ROLE : кто инициировал
USER ..> ROLE : роль сотрудника

' ─── Связи: оценка риска ─────────────────────────────────────────────
WI "1" --> "0..*" REPORT : поставляет сведения об угрозах (FR-6)
REPORT "1" o-- "1..*" THREAT : угрозы по участкам маршрута
THREAT ..> SEG : относится к участку
REQ "1" o-- "0..*" RISK : оценки риска рейса; учитывают\nценность груза (FR-7, FR-13, FR-14)
RISK ..> REPORT : рассчитана по сведениям об угрозах
RISK ..> LEVEL : уровень риска для диспетчера (FR-8)

' ─── Связи: аудит ────────────────────────────────────────────────────
ORG "1" o-- "0..*" AUDIT : события организации (RL-4)
HIST "0..1" -- "0..1" AUDIT : переход статуса попадает в журнал

' ─── Связи: полевые события рейса ───────────────────────────────────
REQ "1" *-- "0..*" STAGE : план этапов рейса (FR-18)
STAGE "0..*" --> "0..1" CP : плановая контрольная точка
STAGE "1" *-- "0..1" LOG : отметка о прохождении
REQ "1" *-- "0..*" INC : инциденты рейса (FR-19)
INC "1" *-- "0..*" PART : участники инцидента (FR-20)
INC "0..*" --> "1" USER : кто сообщил об инциденте
INC "1" o-- "0..*" RECOVERY : основание для реагирования (FR-21)

' ─── Опорный порядок для раскладки (связи не отображаются) ───────────
ORG -[hidden]down- REQ
REQ -[hidden]down- ROUTE
ROUTE -[hidden]down- SEG
SEG -[hidden]down- CP
USER -[hidden]right- ORG
REQ -[hidden]right- RISK
RISK -[hidden]down- REPORT
REPORT -[hidden]down- THREAT
STAGE -[hidden]down- INC

note right of REQ
  **Рейс — центральное понятие**
  Диспетчер создаёт заявку (UC-1), система подбирает
  маршрут (UC-5), считает время в пути (UC-6) и риск
  (UC-7), даёт рекомендацию по охране и припасам (UC-8).
  Дальше рейс живёт статусной моделью (UC-2)
  и виден в реестре (UC-3).
end note

note bottom of RISK
  **Оценка риска обновляется каждым расчётом**
  Если внешняя система недоступна, оценка получает
  значение «Н/Д» и пометку «требует пересчёта»;
  если сведения старше суток — пометку
  «на основе устаревших данных».
end note

note bottom of INC
  **Полевые события рейса**
  Отметки прохождения этапов и карточки инцидентов
  создаются на полевом устройстве и попадают в систему
  при появлении связи (RL-1).
end note

legend right
  |= Обозначение |= Значение |
  | <#F5F5F5> | понятие реализовано в системе |
  | <#EDE7F6> | «внешняя система» и данные, которые она поставляет |
  **Уровень описания.** Только предметная область: понятия, их деловые
  свойства и связи. Ни классов реализации, ни методов, ни типов данных,
  ни слоёв, ни хранилищ — это уровни Logical и Implementation View.
  **Свойства** перечислены деловыми именами, без типов: тип и формат
  появляются на CLS_LogicalView, фактическое объявление —
  на CLS_ImplementationView.
  **Перечисления** показаны там, где набор значений сам является
  понятием модели и обсуждается с заказчиком.
  **Типы связей:** ""*--"" композиция (часть не существует без целого),
  ""o--"" агрегация, ""-->"" ассоциация, ""..>"" зависимость
  (на зависимостях кратности не указываются).
  **Трассировка:** FR-2 и FR-3 (статусы и история), FR-4 (маршрут),
  FR-6 (Wasteland Intel), FR-7 (risk_score), FR-8 (рекомендация),
  FR-13 и FR-14 (ценность груза), FR-18 (этапы рейса),
  FR-19 — FR-21 (инциденты и реагирование), FR-23 и FR-24
  (организация и изоляция её данных), RL-1 (офлайн-фиксация),
  RL-4 (журнал аудита). Перечень прецедентов — docs/UseCases.md.
endlegend
@enduml
