@startuml SEQ_UC1_ImplementationView
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #F5F5F5
skinparam ParticipantBorderColor #333333
skinparam ActorBackgroundColor #F5F5F5
skinparam DatabaseBackgroundColor #F5F5F5
skinparam BoxPadding 8
skinparam SequenceMessageFontName Courier

title UC-1 «Создать заявку на перевозку» — Sequence Diagram (Implementation View)\nРеальные классы, методы, предусловия и HTTP-контракт реализации

actor "Диспетчер" as D

box "frontend (React 18 + Vite)" #FDFDFD
  participant "console:Console.tsx\n(OrgDispatch)" as CON
  participant "form:RequestForm.tsx" as UI
  participant "api:api.ts (axios)" as API
end box

box "backend (Spring Boot 3, Java 21)" #FDFDFD
  participant "c:RequestController\n<<@RestController>>" as WEB
  participant "s:RequestService\n<<@Service>>" as SVC
  participant "eta:EtaService" as ETA
  participant "risk:RiskService" as RISK
  participant "intel:WastelandIntelClient" as INTEL
  participant "st:RequestStatusService" as STAT
  participant "orgRepo:OrganizationRepository\nrouteRepo:RouteRepository\ncpRepo:CheckpointRepository\nsegRepo:RouteSegmentRepository\nrepo:CaravanRequestRepository\nhRepo:RequestStatusHistoryRepository" as REPO
  participant "aRepo:RiskAssessmentRepository" as MREPO
end box

box "инфраструктура" #FDFDFD
  database "PostgreSQL 16" as PG
  database "MongoDB 7" as MG
  participant "mock-intel:WireMock\n(Wasteland Intel)" as WI
end box

note over D, API
  **Предусловия UC-1 в реализации**
  1) Организация выбрана: Console.selectedOrgId() читает ?org=<id>;
     без параметра рендерится OrgPicker и форма заявки не показывается;
     если организаций нет — «Организаций пока нет. Создайте в консоли организаций» (UC-32)
  2) Организация существует — проверяется **только на backend**:
     при неизвестном ?org=<id> OrgDispatch получает org == null, но всё равно
     рендерит RequestForm с organizationId = orgId → см. фрагмент «Предусловие: организация существует»
  3) Справочники загружены: RequestForm рендерится при routes.length > 0 && checkpoints.length > 0
  4) Аутентификация диспетчера **не реализована** (до UC-25)
end note

autonumber "<b>0."
D -> UI : submit(e: FormEvent)
activate UI
UI -> API : createRequest(body: CreateRequestBody)\n// organizationId из Console (?org=)
activate API
API -> WEB : POST /api/requests\n{organizationId, origin, destination, departureDate,\n cargoDescription, cargoValueCaps, routeId | routeName+segments}
activate WEB

alt body.routeId() != null — основной поток
  WEB -> SVC : create(organizationId, origin, destination,\ndepartureDate, cargoDescription, cargoValueCaps, routeId)
else body.segments() != null && !body.segments().isEmpty() — альт. поток 3а
  WEB -> SVC : createWithManualRoute(organizationId, ..., routeName,\nList<SegmentSpec> specs)
else ни routeId, ни segments
  break
    WEB -> WEB : throw new IllegalArgumentException(\n"Нужно указать routeId (шаблон) или segments (ручной маршрут)")
    WEB --> API : HTTP 400 {"message": "..."}
  end
end
activate SVC

group Предусловие: организация существует — RequestService.loadOrganization(organizationId)
  break organizationId == null
    SVC --> WEB : throw new IllegalArgumentException("Не указана организация")
    WEB --> API : HTTP 400 {"message": "Не указана организация"}
  end
  SVC -> REPO : organizationRepository.findById(organizationId)
  activate REPO
  REPO -> PG : SELECT * FROM organization WHERE id = ?
  REPO --> SVC : Optional<Organization>
  deactivate REPO
  break Optional.empty() — организации нет
    SVC --> WEB : throw new IllegalArgumentException(\n"Организация не найдена: " + organizationId)
    WEB --> API : HTTP 400 {"message": "Организация не найдена: ..."}
  end
end

alt create(...) — маршрут из шаблона
  SVC -> REPO : routeRepository.findById(routeId)
  activate REPO
  REPO -> PG : SELECT * FROM route / route_segment
  REPO --> SVC : Optional<Route>
  deactivate REPO
  break Optional.empty()
    SVC --> WEB : throw new IllegalArgumentException("Маршрут не найден: " + routeId)
    WEB --> API : HTTP 400
  end
else createWithManualRoute(...) — ручной маршрут
  SVC -> REPO : routeRepository.save(new Route(nextRouteCode(), name, false))
  activate REPO
  REPO -> PG : INSERT INTO route
  deactivate REPO
  loop для каждого SegmentSpec
    SVC -> REPO : checkpointRepository.findByCode(spec.fromCode() / toCode())
    activate REPO
    REPO -> PG : SELECT * FROM checkpoint WHERE code = ?
    REPO --> SVC : Optional<Checkpoint>
    deactivate REPO
    break Optional.empty()
      SVC --> WEB : throw new IllegalArgumentException(\n"Контрольная точка не найдена: " + code)\n// @Transactional: INSERT INTO route откатывается
      WEB --> API : HTTP 400
    end
  end
  SVC -> REPO : routeSegmentRepository.saveAll(segments)
  activate REPO
  REPO -> PG : INSERT INTO route_segment (ord, from, to, distance_km)
  deactivate REPO
end

SVC -> SVC : build(organization, origin, destination, departureDate,\ncargoDescription, cargoValueCaps, route)
SVC -> SVC : new CaravanRequest(organization, ...)  // status = RequestStatus.DRAFT

SVC -> ETA : computeHours(route) : double
activate ETA
ETA --> SVC : sum(RouteSegment::getDistanceKm) / 4.0 км/ч
deactivate ETA
SVC -> SVC : request.applyEta(etaHours)

SVC -> RISK : calculate(route, cargoValueCaps) : RiskResult
activate RISK
RISK -> RISK : keys = route.getSegments()\n  .map(RouteSegment::segmentKey)
RISK -> INTEL : fetchThreats(keys) : Optional<ThreatReport>
activate INTEL
INTEL -> WI : GET {intel.base-url}/threats?segments=GS-PR,PR-NV\n(connectTimeout = readTimeout = 2000 ms)
activate WI

alt HTTP 200 — данные получены
  WI --> INTEL : {"asOf": "...", "segments":[{segment, threatLevel, threats[]}]}
  INTEL --> RISK : Optional.of(ThreatReport)
  RISK -> RISK : threatSum = Σ threatLevel\nbase = min(100, threatSum * 6)\ncargoFactor = cargoFactor(caps)\nscore = min(100, base + cargoFactor)\nstatus = isStale(asOf) ? "STALE" : "OK"\nrecommendation(score)
  RISK --> SVC : new RiskResult(score, status, recommendation,\nasOf, threatSum, base, cargoFactor, segments)
else исключение / таймаут — альт. поток 4а
  WI --> INTEL : ошибка соединения
  INTEL --> RISK : Optional.empty()
  RISK --> SVC : RiskResult.unavailable()\n// score = null, status = "NA"
end
deactivate WI
deactivate INTEL
deactivate RISK
SVC -> SVC : request.applyRisk(risk.score(), risk.status(),\nrisk.recommendation())

SVC -> REPO : requestRepository.save(request)
activate REPO
REPO -> PG : INSERT INTO caravan_request\n(organization_id NOT NULL, origin, destination, departure_date,\n cargo_description, cargo_value_caps, route_id,\n eta_hours, risk_score, risk_status, recommendation, status='DRAFT')
PG --> REPO : id : UUID
REPO --> SVC : saved : CaravanRequest
deactivate REPO

SVC -> RISK : saveAssessment(saved.getId(), risk)
activate RISK
RISK -> MREPO : assessmentRepository.save(\nnew RiskAssessment(requestId, result, Instant.now()))
activate MREPO
MREPO -> MG : db.risk_assessment.insertOne({...})
deactivate MREPO
deactivate RISK

SVC -> STAT : recordCreation(saved)
activate STAT
STAT -> REPO : historyRepository.save(new RequestStatusHistory(\nrequest, null, DRAFT, ActorRole.DISPATCHER, null, "Заявка создана"))
activate REPO
REPO -> PG : INSERT INTO request_status_history
deactivate REPO
deactivate STAT

SVC --> WEB : saved : CaravanRequest
deactivate SVC
WEB -> WEB : RequestResponse.from(created)
WEB --> API : HTTP 201 Created\n{id, organizationId, routeCode, etaHours,\n riskScore, riskStatus, recommendation,\n status:"DRAFT", statusLabel:"Черновик", ...}
deactivate WEB
API --> UI : Promise<CaravanRequest>
deactivate API
UI -> CON : onCreated(created)
activate CON
CON -> CON : setCreated(n => n + 1)\n// RequestRegistry: reloadToken изменился → load()
CON -> API : getRegistry(organizationId, query)\nGET /api/requests/registry
CON --> D : заявка в реестре организации\n(StatusBadge «Черновик», RiskBadge)
deactivate CON
deactivate UI

group Общая обработка отказов (все фрагменты break)
  WEB -> WEB : IllegalArgumentException\n→ handleBadRequest(e) @ExceptionHandler → HTTP 400 ErrorResponse(message)
  API --> UI : rejected Promise
  UI -> UI : setError(err.response.data.message\n?? 'Ошибка создания заявки')
end

note over SVC, MREPO
  Транзакционность: @Transactional на RequestController.create(...)
  и RequestService.create(...) / createWithManualRoute(...) — запись в PostgreSQL атомарна,
  при любом break изменения откатываются; запись снимка в MongoDB — вне транзакции JPA
end note

note over WI
  Известные ограничения реализации:
  • mock-intel отдаёт фиксированный asOf (2287) — ветка "STALE" не воспроизводится,
    хотя реализована в RiskService.isStale(...)
  • audit-событие REQUEST_CREATED в MongoDB не пишется (пробел UC-1)
end note
@enduml
