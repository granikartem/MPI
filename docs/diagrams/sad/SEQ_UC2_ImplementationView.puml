@startuml SEQ_UC2_ImplementationView
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #F5F5F5
skinparam ParticipantBorderColor #333333
skinparam ActorBackgroundColor #F5F5F5
skinparam DatabaseBackgroundColor #F5F5F5
skinparam BoxPadding 8
skinparam SequenceMessageFontName Courier

title UC-2 «Управлять статусами заявки» — Sequence Diagram (Implementation View)\nРеальные классы, методы и HTTP-контракт перехода статуса

actor "Диспетчер /\nкараван-мастер" as U

box "frontend (React 18 + TypeScript)" #FDFDFD
  participant "modal:StatusModal.tsx" as MODAL
  participant "list:RequestList.tsx" as LIST
  participant "reg:RequestRegistry.tsx" as REG
  participant "api:api.ts (axios)" as API
end box

box "backend (Spring Boot 3, Java 21)" #FDFDFD
  participant "c:RequestStatusController" as C
  participant "rs:RequestService" as RS
  participant "st:RequestStatusService" as ST
  participant "RequestStatusMachine" as SM
  participant "RequestReadinessGuard" as G
  participant "repo:CaravanRequestRepository" as REPO
  participant "hRepo:RequestStatusHistoryRepository" as HREPO
  participant "aRepo:AuditEventRepository" as AREPO
end box

box "хранилища" #FDFDFD
  database "PostgreSQL 16" as PG
  database "MongoDB 7" as MG
end box

U -> MODAL : 1: apply(t: StatusTransition)
activate MODAL
MODAL -> API : 1.1: updated = await changeStatus(id, body)
activate API
API -> C : 1.1.1: POST /api/requests/{id}/status : HTTP 200 | 400 | 409
activate C

C -> RS : 1.1.1.1: request = getById(id)
activate RS
RS -> REPO : 1.1.1.1.1: findById(id) : Optional<CaravanRequest>
activate REPO
REPO -> PG : 1.1.1.1.1.1: SELECT * FROM caravan_request WHERE id = ?
deactivate REPO
deactivate RS
break Optional.empty() → IllegalArgumentException
  C -> C : 1.1.1.2: handleBadRequest(e) : HTTP 400
  MODAL -> MODAL : 1.2: setError(message)
end

C -> C : 1.1.1.2: target = RequestStatus.parse(...)\nrole = ActorRole.parse(...)
C -> ST : 1.1.1.3: updated = changeStatus(request, target, role,\nactorName, reason)  // @Transactional
activate ST
ST -> SM : 1.1.1.3.1: transition = find(current, target) : Optional<Transition>
break current == target || transition пусто || !transition.roles().contains(role)\n|| transition.reasonRequired() && reason == null
  ST -> ST : 1.1.1.3.2: throw StatusTransitionException(message)
  C -> C : 1.1.1.4: handleConflict(e) : HTTP 409
  MODAL -> MODAL : 1.2: setError(message)
end
ST -> G : 1.1.1.3.2: blocker = blockerFor(request, target) : String
break blocker != null
  C -> C : 1.1.1.4: handleConflict(e) : HTTP 409
  MODAL -> MODAL : 1.2: setError(blocker)
end

ST -> ST : 1.1.1.3.3: request.changeStatus(target)
ST -> REPO : 1.1.1.3.4: saved = save(request)
activate REPO
REPO -> PG : 1.1.1.3.4.1: UPDATE caravan_request SET status = ?
deactivate REPO
ST -> HREPO : 1.1.1.3.5: save(statusHistory)
activate HREPO
HREPO -> PG : 1.1.1.3.5.1: INSERT INTO request_status_history
deactivate HREPO
ST -> AREPO : 1.1.1.3.6: save(auditEvent)
activate AREPO
AREPO -> MG : 1.1.1.3.6.1: db.audit_event.insertOne({type: "REQUEST_STATUS_CHANGED", ...})
deactivate AREPO
deactivate ST
C -> C : 1.1.1.4: RequestResponse.from(updated) : HTTP 200
deactivate C
deactivate API

MODAL -> LIST : 1.2: onUpdated(updated)
activate LIST
LIST -> REG : 1.2.1: onChanged() → load()
activate REG
REG ->> API : 1.2.1.1: getRegistry(organizationId, query)\nGET /api/requests/registry
deactivate REG
deactivate LIST
MODAL ->> API : 1.3: getStatusInfo(id)\nGET /api/requests/{id}/status
MODAL ->> API : 1.4: getStatusHistory(id)\nGET /api/requests/{id}/status-history
MODAL ->> U : 1.5: показать новый статус и историю переходов
deactivate MODAL

legend right
  Нумерация иерархическая: целое число — действие актора,
  вложенные вызовы — 1.1, 1.1.1, …
  Сплошная линия, закрашенная стрелка — синхронный вызов;
  результат вызова — в подписи: «результат = операция(...)».
  Сплошная линия, открытая стрелка — асинхронный вызов:
  getRegistry, getStatusInfo, getStatusHistory запускаются
  без ожидания результата (Promise без await).
endlegend
@enduml
