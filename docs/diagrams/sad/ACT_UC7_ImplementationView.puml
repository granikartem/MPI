title UC-7 «Рассчитать risk_score» — Activity Diagram (Implementation View)

start

partition "frontend/src: RequestList.tsx → api.ts (axios)" {
  :recalc(id) → recalcRisk(id);
  :POST /api/requests/{id}/risk-score;
}

partition "RequestController.recalculateRisk(UUID id)\n<<@RestController>> @Transactional" {
  :делегировать в service.recalculateRisk(id);
}

partition "RequestService.recalculateRisk(UUID id)\n<<@Service>> @Transactional" {
  :getById(id) → requestRepository.findById(id);
  if (заявка найдена?) then (да)
    :request.getRoute(),\nrequest.getCargoValueCaps();
  else (нет)
    :throw new IllegalArgumentException;<<#MistyRose>>
    :@ExceptionHandler → HTTP 400\nErrorResponse(message);<<#MistyRose>>
    stop
  endif
  :riskService.calculate(route, cargoValueCaps);
}

partition "RiskService.calculate(Route, int) <<@Service>>" {
  :собрать ключи участков маршрута\nsegmentKey = код «откуда» + "-" + код «куда»;
  :intelClient.fetchThreats(keys);
}

partition "WastelandIntelClient.fetchThreats(List<String>)\n<<@Component>>" {
  :GET ${intel.base-url}/threats?segments=…\nconnectTimeout = readTimeout = 2000 ms;
}

if (ответ разобран в ThreatReport?) then (да — основной поток)
  partition "RiskService.calculate: расчёт оценки" {
    :получен отчёт: asOf\nи угрозы по участкам;
    :сопоставить угрозы участкам маршрута\n(участок без данных → threatLevel = 0);
    :threatSum = сумма threatLevel\nbase = min(100, threatSum × 6);
    :cargoFactor: >= 20 000 → 30; >= 5 000 → 20;\n>= 1 000 → 10; иначе → 0   (FR-14);
    :score = min(100, base + cargoFactor);
    if (asOf старше 24 часов?) then (да — альт. поток 2б)
      :status = "STALE";<<#OldLace>>
    else (нет)
      :status = "OK";
    endif
    :recommendation(score), пороги 80 / 60 / 30   (FR-8);
    :вернуть RiskResult: оценка, статус,\nрекомендация, asOf, разбор по участкам;
  }
else (нет: исключение, таймаут, ошибка HTTP — альт. поток 2а)
  :RiskResult.unavailable()\nscore = null; status = "NA";\nrecommendation = "risk_score требует пересчёта\n— Wasteland Intel недоступен";<<#MistyRose>>
endif

partition "RequestService.recalculateRisk: фиксация результата" {
  :request.applyRisk(score, status, recommendation);
  :requestRepository.save(request)\n→ caravan_request: risk_score,\n   risk_status, recommendation;
  :riskService.saveAssessment(id, risk)\n→ коллекция risk_assessment;
}

partition "RequestController.recalculateRisk: возврат ответа" {
  :RequestResponse.from(saved) → HTTP 200\n{riskScore, riskStatus, recommendation, …};
}

stop

legend right
  **Обозначения**
  • розовым выделен альт. поток 2а и обработка ошибок,
    песочным — альт. поток 2б (status = "STALE")
  **Требования (docs/SRS.md)**
  • FR-6, FR-7, FR-8, FR-14
endlegend
@enduml
