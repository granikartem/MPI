@startuml COL_UC32_LogicalView
!pragma layout smetana
skinparam shadowing false
skinparam objectBackgroundColor #F5F5F5
skinparam objectBorderColor #333333
skinparam packageStyle rectangle
skinparam ArrowColor #333333

title UC-32 «Создать организацию» — Cooperative (Communication) Diagram (Logical View)\nКооперация логических компонентов; уровни совпадают с диаграммой пакетов

object "Суперпользователь" as SU <<actor>> #White

package "presentation" {
  object ":Интерфейс управления\nорганизациями" as PRES
}

package "application" {
  object ":Создание организации\n(UC-32)" as APP
}

package "domain" {
  object ":Организация" as ORG
  object ":Учётная запись" as USR
  object ":Событие аудита" as EVT
}

package "infrastructure" {
  object ":Хранение данных" as STORE
  object ":Журнал аудита" as AUDIT
}

SU --> PRES : 1: заполнить данные организации\nи первого диспетчера, подтвердить
PRES --> APP : 1.1: создатьОрганизацию(данные организации,\nданные первого диспетчера)

APP --> STORE : 1.1.1: найти организацию по названию\n1.1.2 [диспетчер задан]: найти пользователя по логину\n1.1.4: сохранить организацию\n1.1.6 [диспетчер задан]: сохранить учётную запись
APP --> ORG : 1.1.3 [название и логин свободны]:\nсоздать организацию (ключ арендатора,\nуровень подписки, статус «активна»)
APP --> USR : 1.1.5 [диспетчер задан]: создать учётную запись\nс ролью «Диспетчер», привязанную к организации
APP --> EVT : 1.1.7: сформировать событие\n«организация создана»
APP --> AUDIT : 1.1.8: записать событие

APP --> PRES : 1.2: результат (организация,\nпервый диспетчер)
PRES --> SU : 2: организация добавлена в реестр,\nпоказаны ключ арендатора и логин диспетчера

note as N_Pre
  **Предусловия**
  • суперпользователь аутентифицирован
  • организации с таким названием нет (без учёта регистра) — проверка 1.1.1
  • логин первого диспетчера свободен — проверка 1.1.2
  Если предусловие не выполнено, сообщения 1.1.3–1.1.8 не выполняются,
  интерфейс показывает ошибку (альт. поток 4а)
end note

note as N_Layers
  **Уровни взаимодействия** (слои диаграммы пакетов)
  • presentation — приём данных формы, ответ об успехе или ошибке
  • application — сценарий создания организации в единой транзакции
  • domain — «Организация», «Учётная запись», «Событие аудита»
  • infrastructure — хранение оперативных данных и журнал аудита
  Зависимости: presentation → application → domain;
  application → infrastructure (<<access>>)
end note

note bottom of APP
  **Альт. поток 6а:** данные первого диспетчера не заданы —
  сообщения 1.1.2, 1.1.5 и 1.1.6 пропускаются,
  организация создаётся без пользователей
end note
@enduml
