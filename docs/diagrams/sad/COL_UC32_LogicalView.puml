@startuml COL_UC32_LogicalView
!pragma layout smetana
skinparam shadowing false
skinparam objectBackgroundColor #F5F5F5
skinparam objectBorderColor #333333
skinparam packageStyle rectangle
skinparam ArrowColor #333333

title UC-32 «Создать организацию» — Cooperative (Communication) Diagram (Logical View)\nОбъекты по слоям приложения; уровни совпадают с диаграммой пакетов

object "Суперпользователь" as SU <<actor>> #White

package "frontend" {
  object ":Консоль организаций" as UI <<pages>>
  object ":Клиент REST API" as API <<api>>
}

package "backend" {
  package "web" {
    object ":Контроллер организаций" as WEB <<controller>>
  }
  package "service" {
    object ":Сервис организаций" as SVC <<service>>
  }
  package "domain" {
    object ":Организация" as ORG <<entity>>
    object ":Учётная запись" as USR <<entity>>
    object ":Событие аудита" as EVT <<entity>>
  }
  package "repository" {
    object ":Репозиторий организаций" as OREPO <<repository>>
    object ":Репозиторий пользователей" as UREPO <<repository>>
    object ":Репозиторий событий аудита" as AREPO <<repository>>
  }
}

package "инфраструктура" {
  object ":PostgreSQL" as PG <<database>>
  object ":MongoDB" as MG <<database>>
}

SU --> UI : 1: заполнить форму организации\nи первого диспетчера, подтвердить
UI --> API : 1.1: создатьОрганизацию(данные формы)
API --> WEB : 1.1.1: запрос создания организации\n(контракт REST)
WEB --> SVC : 1.1.1.1: создатьОрганизацию(команда создания)

SVC --> OREPO : 1.1.1.1.1: найти организацию по названию\n(проверка уникальности)\n1.1.1.1.4: сохранить организацию
SVC --> UREPO : 1.1.1.1.2: найти пользователя по логину\n(проверка уникальности)\n1.1.1.1.5: сохранить учётную запись диспетчера
SVC --> ORG : 1.1.1.1.3: создать организацию\n(ключ арендатора, уровень подписки,\nстатус «активна»)
SVC --> USR : 1.1.1.1.6: создать учётную запись\nс ролью «Диспетчер» и хешем пароля
SVC --> EVT : 1.1.1.1.7: сформировать событие\n«организация создана»
SVC --> AREPO : 1.1.1.1.8: сохранить событие аудита

OREPO --> PG : 1.1.1.1.1.1: чтение / запись\nтаблицы организаций
UREPO --> PG : 1.1.1.1.2.1: чтение / запись\nтаблицы пользователей
AREPO --> MG : 1.1.1.1.8.1: запись документа\nв коллекцию событий аудита

SVC --> WEB : 1.1.1.2: результат подготовки организации\n(организация, диспетчер, число пользователей)
WEB --> API : 1.1.2: представление организации
API --> UI : 1.2: данные созданной организации
UI --> SU : 2: организация добавлена в реестр,\nвыведены ключ арендатора и логин диспетчера

note as N_Layers
  **Правила взаимодействия слоёв**
  • frontend обращается к backend только через REST-контракт слоя web
  • слой web не содержит бизнес-логики: разбор запроса, коды ответов, обработка ошибок
  • вся логика прецедента — в слое service (единая транзакция)
  • слой domain хранит состояние сущностей, слой repository изолирует доступ к БД
  • оперативные данные — PostgreSQL, поток событий аудита — MongoDB
end note

note bottom of SVC
  **Альт. поток 4а:** название организации занято —
  сообщения 1.1.1.1.3–1.1.1.1.8 не выполняются,
  слой web возвращает ошибку, форма показывает её пользователю
  **Альт. поток 6а:** данные первого диспетчера не заданы —
  сообщения 1.1.1.1.2, 1.1.1.1.5 и 1.1.1.1.6 пропускаются
end note
@enduml
