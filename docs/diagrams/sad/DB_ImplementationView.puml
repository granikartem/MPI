@startuml DB_ImplementationView
!pragma layout smetana
title Data Base Diagram ИС «Караваны» (Implementation View)

skinparam class {
    BackgroundColor #lightyellow
    BorderColor black
}
skinparam package {
    BackgroundColor #white
    BorderColor black
}

package "PostgreSQL (оперативные данные)" <<Database>> {
    class "caravan_requests" <<table>> {
        + id : UUID <<PK>>
        --
        + organization_id : UUID <<FK>> <<index>>
        + status : VARCHAR(50)
        + created_at : TIMESTAMP
        + eta : TIMESTAMP
        + cargo_value : NUMERIC(19,2)
        + risk_score : NUMERIC(10,2)
        + route_id : UUID <<FK>>
        + manifest_id : UUID <<FK>>
        + team_id : UUID <<FK>>
        + supply_id : UUID <<FK>>
        + deleted : BOOLEAN <<index>>
    }

    class "routes" <<table>> {
        + id : UUID <<PK>>
        --
        + start_point : VARCHAR(255)
        + end_point : VARCHAR(255)
        + estimated_time : BIGINT
    }

    class "checkpoints" <<table>> {
        + id : UUID <<PK>>
        --
        + route_id : UUID <<FK>>
        + name : VARCHAR(255)
        + location : VARCHAR(255)
        + sequence_number : INTEGER
    }

    class "cargo_manifests" <<table>> {
        + id : UUID <<PK>>
        --
        + organization_id : UUID <<FK>>
        + seals : JSONB
    }

    class "cargo_items" <<table>> {
        + id : UUID <<PK>>
        --
        + manifest_id : UUID <<FK>>
        + description : VARCHAR(500)
        + quantity : INTEGER
        + weight : NUMERIC(10,2)
        + is_special : BOOLEAN
    }

    class "teams" <<table>> {
        + id : UUID <<PK>>
        --
        + master_id : UUID <<FK>>
        + medic_id : UUID <<FK>>
    }

    class "team_guards" <<join table>> {
        + team_id : UUID <<FK>>
        + guard_id : UUID <<FK>>
    }

    class "users" <<table>> {
        + id : UUID <<PK>>
        --
        + organization_id : UUID <<FK>> <<index>>
        + login : VARCHAR(100) <<unique>>
        + password_hash : VARCHAR(255)
        + full_name : VARCHAR(255)
        + role : VARCHAR(50)
        + active : BOOLEAN <<index>>
    }

    class "organizations" <<table>> {
        + id : UUID <<PK>>
        --
        + name : VARCHAR(255)
        + subscription_level : VARCHAR(50)
        + created_at : TIMESTAMP
    }

    class "supply_reservations" <<table>> {
        + id : UUID <<PK>>
        --
        + water : NUMERIC(10,2)
        + food : NUMERIC(10,2)
        + ammunition : NUMERIC(10,2)
        + repair_kits : NUMERIC(10,2)
        + medical_supplies : NUMERIC(10,2)
    }

    class "financial_reports" <<table>> {
        + id : UUID <<PK>>
        --
        + request_id : UUID <<FK>>
        + total_cost : NUMERIC(19,2)
        + taxes : NUMERIC(19,2)
        + total_revenue : NUMERIC(19,2)
        + net_result : NUMERIC(19,2)
        + generated_at : TIMESTAMP
    }
}

package "MongoDB (события и аудит)" <<Database>> {
    class "incidents" <<document>> {
        + _id : ObjectId <<PK>>
        --
        + request_id : UUID <<index>>
        + type : String
        + severity : String
        + timestamp : ISODate
        + location : GeoJSON
        + description : String
        + created_by : UUID
        + attachments : Array<Binary>
    }

    class "recovery_requests" <<document>> {
        + _id : ObjectId <<PK>>
        --
        + incident_id : UUID <<index>>
        + type : String
        + status : String
        + created_at : ISODate
        + updated_at : ISODate
        + description : String
    }

    class "checkpoint_logs" <<document>> {
        + _id : ObjectId <<PK>>
        --
        + request_id : UUID <<index>>
        + checkpoint_id : UUID
        + timestamp : ISODate
        + status : String
        + tax_paid : NUMERIC(19,2)
        + currency : String
        + delay_reason : String
    }

    class "audit_log" <<document>> {
        + _id : ObjectId <<PK>>
        --
        + entity_type : String <<index>>
        + entity_id : UUID <<index>>
        + action : String
        + user_id : UUID <<index>>
        + timestamp : ISODate
        + changes : Document
        + ip_address : String
    }
}

' Внешние ключи
caravan_requests --> routes : route_id
caravan_requests --> cargo_manifests : manifest_id
caravan_requests --> teams : team_id
caravan_requests --> supply_reservations : supply_id
caravan_requests --> organizations : organization_id
caravan_requests --> financial_reports : id
checkpoints --> routes : route_id
cargo_items --> cargo_manifests : manifest_id
team_guards --> teams : team_id
team_guards --> users : guard_id
teams --> users : master_id
teams --> users : medic_id
users --> organizations : organization_id
financial_reports --> caravan_requests : request_id
incidents --> caravan_requests : request_id
recovery_requests --> incidents : incident_id
checkpoint_logs --> caravan_requests : request_id
@enduml
