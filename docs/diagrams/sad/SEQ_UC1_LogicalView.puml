@startuml SEQ_UC1_LogicalView
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #F5F5F5
skinparam ParticipantBorderColor #333333
skinparam ActorBackgroundColor #F5F5F5
skinparam BoxPadding 8

title UC-1 «Создать заявку на перевозку» — Sequence Diagram (Logical View)\nВзаимодействие логических компонентов; уровни совпадают с диаграммой пакетов

actor "Диспетчер\nкараванов" as D

box "presentation" #FDFDFD
  participant "Интерфейс\nзаявок" as PRES
end box

box "application" #FDFDFD
  participant "Создание заявки\n(UC-1)" as APP
  participant "Расчёт ETA\n(UC-6)" as ETA
  participant "Оценка риска\n(UC-7, UC-8)" as RISK
end box

box "domain" #FDFDFD
  participant "Маршрут" as ROUTE
  participant "Заявка" as REQ
end box

box "infrastructure" #FDFDFD
  participant "Хранение\nданных" as STORE
  participant "Адаптер\nWasteland Intel" as ADAPTER
end box

box "внешняя система" #FDFDFD
  participant "Wasteland Intel" as WI
end box

autonumber "<b>0."
D -> PRES : заполнить форму заявки\nи подтвердить создание
activate PRES

break не указан ни шаблон маршрута, ни участки
  PRES --> D : отказ: «нужно указать маршрут»
end

PRES -> APP : создать заявку(организация, данные заявки,\nшаблон маршрута или участки)
activate APP

group Предусловие: заявка создаётся в существующей организации
  APP -> STORE : найти организацию
  activate STORE
  STORE --> APP : организация или «не найдена»
  deactivate STORE
  break организация не указана или не найдена
    APP --> PRES : отказ: «организация не найдена»
    PRES --> D : ошибка, заявка не создана
  end
end

alt основной поток: маршрут из шаблона
  APP -> STORE : получить шаблон маршрута
  activate STORE
  STORE --> APP : маршрут с участками
  deactivate STORE
else альт. поток 3а: маршрут задан вручную
  APP -> STORE : найти контрольные точки участков
  activate STORE
  STORE --> APP : контрольные точки
  deactivate STORE
  APP -> ROUTE : сформировать маршрут\nиз последовательности участков
  activate ROUTE
  ROUTE --> APP : маршрут
  deactivate ROUTE
  APP -> STORE : сохранить маршрут
end

APP -> ETA : рассчитать ETA(маршрут)
activate ETA
ETA --> APP : длительность рейса
deactivate ETA

APP -> RISK : оценить риск(маршрут, ценность груза)
activate RISK
RISK -> ADAPTER : запросить угрозы(участки маршрута)
activate ADAPTER
ADAPTER -> WI : запрос данных об угрозах
activate WI

alt внешняя система ответила
  WI --> ADAPTER : угрозы по участкам, дата актуальности
  ADAPTER --> RISK : отчёт об угрозах
  RISK -> RISK : агрегировать угрозы, учесть ценность груза,\nсформировать рекомендацию по охране и припасам
  RISK --> APP : оценка риска\n(актуальная или на устаревших данных)
else альт. поток 4а: источник недоступен
  WI --> ADAPTER : ошибка / таймаут
  ADAPTER --> RISK : данных нет
  RISK --> APP : оценка «требует пересчёта»
end
deactivate WI
deactivate ADAPTER
deactivate RISK

APP -> REQ : создать заявку в статусе «Черновик»\n(организация, маршрут, ETA, риск, рекомендация)
activate REQ
REQ --> APP : заявка
deactivate REQ

APP -> STORE : сохранить заявку
APP -> STORE : сохранить снимок оценки риска
APP -> STORE : записать стартовую запись\nистории статусов («— → Черновик»)

APP --> PRES : созданная заявка
deactivate APP
PRES --> D : заявка добавлена в реестр\nсо статусом и risk_score
deactivate PRES

note over PRES, STORE
  Зависимости между уровнями — как на диаграмме пакетов:
  presentation → application → domain; application обращается к infrastructure (<<access>>);
  внешняя система доступна только через адаптер уровня infrastructure
end note
@enduml
