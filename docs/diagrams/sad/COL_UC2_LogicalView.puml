@startuml COL_UC2_LogicalView
!pragma layout smetana
skinparam shadowing false
skinparam objectBackgroundColor #F5F5F5
skinparam objectBorderColor #333333
skinparam packageStyle rectangle
skinparam ArrowColor #333333

title UC-2 «Управлять статусами заявки» — Cooperative (Communication) Diagram (Logical View)\nКооперация логических компонентов слоёв: параметры, результаты и сторожевые условия сообщений

object "Диспетчер /\nКараван-мастер" as U <<actor>> #White

package "presentation" {
  object ":Интерфейс заявок" as PRES <<компонент слоя>>
  PRES : принимает команду перехода
  PRES : показывает статус, историю и отказы
}

package "application" {
  object ":Управление статусами\n(UC-2)" as APP <<компонент слоя>>
  APP : сценарий перехода в одной транзакции
  APP : обращается к infrastructure <<access>>
}

package "domain" {
  object ":Заявка" as REQ <<компонент слоя>>
  REQ : хранит текущий статус

  object ":Статусная модель\nзаявки" as SM <<компонент слоя>>
  SM : допустимость перехода, роли,\nобязательность причины, финальность

  object ":Запись истории\nстатусов" as HIST <<компонент слоя>>
  object ":Событие аудита" as EVT <<компонент слоя>>
}

package "infrastructure" {
  object ":Хранение данных" as STORE <<компонент слоя>>
  object ":Журнал аудита" as AUDIT <<компонент слоя>>
}

U --> PRES : 1: выбрать действие перехода\n(целевой статус, роль, имя актора, причина)
PRES --> APP : 1.1: заявка = сменитьСтатус(идентификатор заявки,\nцелевой статус, роль, имя актора, причина)
APP --> STORE : 1.1.1: заявка = найти заявку(идентификатор)\n1.1.5: сохранить заявку(заявка)\n1.1.7: сохранить запись истории(запись)
APP --> SM : 1.1.2: переход = найти переход(текущий статус, целевой статус)\n1.1.3: допустим = проверить(переход, роль, причина,\nготовность рейса)
APP --> REQ : 1.1.4 [допустим]: установить статус(целевой статус)
APP --> HIST : 1.1.6: запись = создать(из статуса, в статус,\nроль, имя актора, причина)
APP --> EVT : 1.1.8: событие = сформировать(«статус изменён»,\nорганизация, заявка, переход, актор)
APP --> AUDIT : 1.1.9: записать событие(событие)
PRES --> U : 1.2: показать новый статус\nи историю переходов

note bottom of APP
  [не допустим] — сообщения 1.1.4–1.1.9 не выполняются,
  заявка остаётся в прежнем статусе, интерфейс показывает
  причину отказа (роль, отсутствие причины, финальный статус)
end note

legend right
  Нумерация иерархическая: целое число — действие актора,
  вложенные вызовы — 1.1, 1.1.1, …
  **Отличие от Use-Case View:** вместо аналитических объектов
  <<boundary>> / <<control>> / <<entity>> здесь логические
  компоненты слоёв диаграммы пакетов; у сообщений указаны
  параметры, результаты и сторожевые условия.
  Зависимости: presentation → application → domain;
  application → infrastructure (<<access>>).
endlegend
@enduml
