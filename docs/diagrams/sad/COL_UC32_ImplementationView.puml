@startuml COL_UC32_ImplementationView
!pragma layout smetana
skinparam shadowing false
skinparam objectBackgroundColor #F5F5F5
skinparam objectBorderColor #333333
skinparam packageStyle rectangle
skinparam ArrowColor #333333
skinparam defaultFontName Courier

title UC-32 «Создать организацию» — Cooperative (Communication) Diagram (Implementation View)\nОбъекты реализации: классы, вызываемые методы и хранилища

object "su:Суперпользователь" as SU <<actor>> #White

package "frontend/src (React 18 + TypeScript)" {
  object "page:Organizations.tsx" as UI <<pages>>
  object "api:api.ts (axios)" as API <<api>>
}

package "com.karavany.organization" {
  package "web" {
    object "c:OrganizationController" as WEB <<@RestController>>
  }
  package "service" {
    object "s:OrganizationService" as SVC <<@Service>>
  }
  package "domain" {
    object "org:Organization" as ORG <<@Entity>>
    object "usr:AppUser" as USR <<@Entity>>
  }
  package "repository" {
    object "oRepo:OrganizationRepository" as OREPO <<JpaRepository>>
    object "uRepo:AppUserRepository" as UREPO <<JpaRepository>>
  }
}

package "com.karavany.audit" {
  object "evt:AuditEvent" as EVT <<@Document>>
  object "aRepo:AuditEventRepository" as AREPO <<MongoRepository>>
}

package "инфраструктура (docker compose)" {
  object "pg:PostgreSQL 16" as PG <<database>>
  object "mg:MongoDB 7" as MG <<database>>
}

SU --> UI : 1: submit(e: FormEvent)
UI --> API : 1.1: createOrganization(body: CreateOrganizationBody)
API --> WEB : 1.1.1: POST /api/organizations\n{name, subscriptionTier, legalAddress, primaryContact,\ncontactChannel, region, firstDispatcher{fullName, login,\ninitialPassword, contactChannel}}
WEB --> SVC : 1.1.1.1: create(new CreateOrganizationCommand(...,\nnew FirstDispatcherCommand(...)))\n// @Transactional

note left of SVC
  **Внутренние операции s:OrganizationService**
  1.1.1.1.1: required(command.name(), "Название организации обязательно")
  1.1.1.1.2: normalizeTier(tier) ∈ {BASIC, STANDARD, PRO}
  1.1.1.1.7: generateTenantKey() : "tnt_" + UUID[0..8]
  1.1.1.1.9: passwordHash(pwd) : "sha256:" + hex(SHA-256("karavany:" + pwd))
end note

SVC --> OREPO : 1.1.1.1.3: findByNameIgnoreCase(name) : Optional<Organization>\n1.1.1.1.8: save(org) : Organization
SVC --> UREPO : 1.1.1.1.5: findByLoginIgnoreCase(login) : Optional<AppUser>\n1.1.1.1.10: save(usr) : AppUser

SVC --> ORG : 1.1.1.1.6: new Organization(tenantKey, name, tier,\nlegalAddress, primaryContact, contactChannel, region)\n// status = "ACTIVE", createdAt = now()
SVC --> USR : 1.1.1.1.4: validateDispatcher(dispatcherCommand)\n1.1.1.1.11: new AppUser(organization, fullName, login,\npasswordHash, "DISPATCHER", contactChannel)

SVC --> EVT : 1.1.1.1.12: AuditEvent.organizationCreated(\norganizationId, dispatcherId, name, tier, login)\n// type = "ORGANIZATION_CREATED", actor = "SUPERUSER"
SVC --> AREPO : 1.1.1.1.13: save(evt) : AuditEvent

OREPO --> PG : 1.1.1.1.3.1: SELECT * FROM organization\nWHERE lower(name) = lower(?)\n1.1.1.1.8.1: INSERT INTO organization\n(tenant_key, name, subscription_tier, legal_address,\nprimary_contact, contact_channel, region, status)
UREPO --> PG : 1.1.1.1.5.1: SELECT * FROM app_user WHERE lower(login) = lower(?)\n1.1.1.1.10.1: INSERT INTO app_user\n(organization_id, full_name, login, password_hash, role, contact_channel)
AREPO --> MG : 1.1.1.1.13.1: db.audit_event.insertOne(\n{type, actor, organizationId, userId, details, occurredAt})

SVC --> WEB : 1.1.1.2: new OrganizationProvisioning(\norganization, firstDispatcher, userCount)
WEB --> API : 1.1.2: OrganizationResponse.from(created)\nHTTP 201 Created {id, tenantKey, name, subscriptionTier,\nstatus:"ACTIVE", userCount, firstDispatcher{...}}
API --> UI : 1.2: Promise<Organization>
UI --> SU : 2: setCreated(organization),\nsetOrganizations([organization, ...prev])

note as N_Errors
  **Обработка ошибок**
  IllegalArgumentException («Организация с таким названием уже существует»,
  «Пользователь с таким логином уже существует», «Неизвестный уровень подписки: …»)
  → OrganizationController.handleBadRequest(e) @ExceptionHandler → **HTTP 400** ErrorResponse(message)
  DataIntegrityViolationException (нарушение unique-ограничений БД)
  → handleConflict() → **HTTP 400** «Название организации или логин уже заняты»
  На клиенте: catch → setError(err.response.data.message ?? 'Ошибка создания организации')
end note

note bottom of SVC
  **Альт. поток 6а (диспетчер не назначается):** body.firstDispatcher == null —
  сообщения 1.1.1.1.4, 1.1.1.1.5, 1.1.1.1.9–1.1.1.1.11 не выполняются,
  в audit-событие пишется firstDispatcher = "SKIPPED", userCount = 0
  **Мультитенантность:** tenantKey организации — ключ изоляции данных;
  сущности арендатора (заявки, пользователи) связаны с organization_id
end note
@enduml
