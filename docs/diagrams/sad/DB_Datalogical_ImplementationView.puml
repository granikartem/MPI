title ИС «Караваны» — Data Base Diagram (Implementation View)\nЧасть 2. Даталогическая модель: PostgreSQL 16 (схема public) и MongoDB 7 (база karavany)

' ═══════════════════════════ PostgreSQL 16 ═══════════════════════════
package "PostgreSQL 16 — оперативные данные (DC-4)" <<Database>> {

  package "Организации и доступ" {
    class role <<table, V7>> #FFF2CC {
      id : smallint <<PK>>
      code : varchar(32) NOT NULL <<UQ>>
      name : varchar(64) NOT NULL
      scope : varchar(16) NOT NULL
      crew_required : boolean NOT NULL DEFAULT false
      crew_required_from_risk_score : smallint
      --
      CHECK scope IN (PLATFORM, OFFICE, FIELD, SYSTEM)
      CHECK crew_required_from_risk_score BETWEEN 0 AND 100
    }

    class organization <<table, V3>> #F5F5F5 {
      id : uuid <<PK>> DEFAULT gen_random_uuid()
      tenant_key : varchar(64) NOT NULL <<UQ>>
      name : varchar(255) NOT NULL
      subscription_tier : varchar(32) NOT NULL
      legal_address : varchar(1000)
      primary_contact : varchar(255)
      contact_channel : varchar(255)
      region : varchar(255)
      status : varchar(32) NOT NULL DEFAULT 'ACTIVE'
      created_at : timestamptz NOT NULL DEFAULT now()
      --
      UNIQUE INDEX uq_organization_name_ci (lower(name))
    }

    class subscription <<table, проект UC-34>> #FFF2CC {
      id : uuid <<PK>>
      organization_id : uuid NOT NULL <<FK>>
      tier : varchar(16) NOT NULL
      period_start : date NOT NULL
      period_end : date NOT NULL
      grace_until : date NOT NULL
      status : varchar(16) NOT NULL
      created_at : timestamptz NOT NULL DEFAULT now()
      --
      CHECK tier IN (BASIC, STANDARD, PRO)
      CHECK status IN (ACTIVE, GRACE, BLOCKED)
      CHECK grace_until = period_end + 30
      INDEX ix_subscription_org_end (organization_id, period_end DESC)
    }

    class terminal <<table, проект Vision 4.5>> #FFF2CC {
      id : uuid <<PK>>
      organization_id : uuid NOT NULL <<FK>>
      subscription_id : uuid NOT NULL <<FK>>
      name : varchar(128) NOT NULL
      api_key_hash : varchar(255) NOT NULL <<UQ>>
      activated_at : timestamptz
      status : varchar(16) NOT NULL
      --
      CHECK status IN (ACTIVE, REVOKED)
    }

    class app_user <<table, V3 + V7>> #E3F2FD {
      id : uuid <<PK>> DEFAULT gen_random_uuid()
      organization_id : uuid <<FK>>  [V7: NULL только у SUPERUSER]
      role_id : smallint NOT NULL <<FK>>  [V7: вместо role varchar(32)]
      full_name : varchar(255) NOT NULL
      login : varchar(128) NOT NULL
      password_hash : varchar(255) NOT NULL
      must_change_password : boolean NOT NULL DEFAULT true  [V7]
      contact_channel : varchar(255)
      active : boolean NOT NULL DEFAULT true
      created_at : timestamptz NOT NULL DEFAULT now()
      --
      UNIQUE INDEX uq_app_user_login_ci (lower(login))
      INDEX ix_app_user_org_role (organization_id, role_id)  [V7]
    }

    class employee_rate <<table, проект UC-31>> #FFF2CC {
      id : uuid <<PK>>
      user_id : uuid NOT NULL <<FK>>
      amount_caps : numeric(12,2) NOT NULL
      valid_from : date NOT NULL
      valid_to : date
      set_by : uuid NOT NULL <<FK>>
      --
      UNIQUE (user_id, valid_from)
      CHECK amount_caps >= 0
    }
  }

  package "Заявка и маршрут" {
    class caravan_request <<table, V1 + V3…V6 + V7>> #E3F2FD {
      id : uuid <<PK>> DEFAULT gen_random_uuid()
      organization_id : uuid NOT NULL <<FK>>
      route_id : uuid <<FK>>
      origin : varchar(255) NOT NULL
      destination : varchar(255) NOT NULL
      departure_date : date NOT NULL
      cargo_description : varchar(2000)
      cargo_value_caps : integer NOT NULL DEFAULT 0
      estimated_delivery_hours : double precision  [V7: переименование eta_hours]
      risk_score : integer
      risk_status : varchar(16) NOT NULL DEFAULT 'NA'
      recommendation : varchar(2000)
      status : varchar(32) NOT NULL DEFAULT 'DRAFT'
      created_at : timestamptz NOT NULL DEFAULT now()
      --
      CHECK ck_caravan_request_status: status IN (DRAFT, READY,
        EN_ROUTE, DELAYED, DELIVERED, CLOSED, CANCELLED)  [V5]
      CHECK risk_status IN (OK, STALE, NA)  [V7]
      CHECK risk_score BETWEEN 0 AND 100  [V7]
      CHECK cargo_value_caps >= 0  [V7]
      INDEX ix_caravan_request_org_created (organization_id, created_at DESC)  [V6]
    }

    class request_status_history <<table, V5 + V7>> #E3F2FD {
      id : uuid <<PK>> DEFAULT gen_random_uuid()
      request_id : uuid NOT NULL <<FK>>
      from_status : varchar(32)
      to_status : varchar(32) NOT NULL
      actor_role_id : smallint NOT NULL <<FK>>  [V7: вместо actor_role varchar(32)]
      actor_user_id : uuid <<FK>>  [V7, после UC-25]
      actor_name : varchar(255)
      reason : varchar(1000)
      occurred_at : timestamptz NOT NULL DEFAULT now()
      --
      INDEX ix_request_status_history_request (request_id, occurred_at)
    }

    class escort_plan <<table, проект UC-8>> #FFF2CC {
      request_id : uuid <<PK, FK>>
      recommended_guards : smallint NOT NULL
      recommended_supply_level : varchar(16) NOT NULL
      accepted_guards : smallint
      accepted_supply_level : varchar(16)
      accepted_by : uuid <<FK>>
      accepted_at : timestamptz
      --
      CHECK *_supply_level IN (BASIC, STANDARD, REINFORCED, DOUBLE)
    }

    class route <<table, V1 + V3 + V4>> #F5F5F5 {
      id : uuid <<PK>>
      code : varchar(32) NOT NULL
      name : varchar(255) NOT NULL
      is_template : boolean NOT NULL DEFAULT true
      organization_id : uuid <<FK>>
      --
      UNIQUE INDEX uq_route_code (code)
    }

    class route_segment <<table, V1>> #F5F5F5 {
      id : uuid <<PK>>
      route_id : uuid NOT NULL <<FK>>
      ord : integer NOT NULL
      from_checkpoint_id : uuid NOT NULL <<FK>>
      to_checkpoint_id : uuid NOT NULL <<FK>>
      distance_km : double precision NOT NULL
      --
      UNIQUE (route_id, ord)  [V7]
      CHECK distance_km > 0  [V7]
    }

    class checkpoint <<table, V1>> #F5F5F5 {
      id : uuid <<PK>>
      code : varchar(64) NOT NULL <<UQ>>
      name : varchar(255) NOT NULL
      is_ncr_gate : boolean NOT NULL DEFAULT false  [проект UC-18]
    }
  }

  package "Команда, груз и припасы" {
    class trip_crew_member <<table, проект UC-9, UC-10>> #FFF2CC {
      id : uuid <<PK>>
      request_id : uuid NOT NULL <<FK>>
      role_id : smallint NOT NULL <<FK>>
      user_id : uuid NOT NULL <<FK>>
      assigned_by : uuid NOT NULL <<FK>>
      assigned_at : timestamptz NOT NULL DEFAULT now()
      --
      UNIQUE (request_id, role_id)
      UNIQUE (request_id, user_id)
      INDEX ix_trip_crew_member_user (user_id)
    }

    class cargo_manifest <<table, проект UC-11>> #FFF2CC {
      id : uuid <<PK>>
      request_id : uuid NOT NULL <<FK>> <<UQ>>
      status : varchar(16) NOT NULL
      created_by : uuid NOT NULL <<FK>>
      created_at : timestamptz NOT NULL DEFAULT now()
      --
      CHECK status IN (DRAFT, SEALED, RECONCILED)
    }

    class cargo_item <<table, проект UC-11>> #FFF2CC {
      id : uuid <<PK>>
      manifest_id : uuid NOT NULL <<FK>>
      ord : integer NOT NULL
      name : varchar(255) NOT NULL
      quantity : numeric(12,3) NOT NULL
      unit : varchar(16) NOT NULL
      weight_kg : numeric(10,2)
      value_caps : integer
      is_special : boolean NOT NULL DEFAULT false
      --
      UNIQUE (manifest_id, ord)
      CHECK quantity > 0
    }

    class cargo_seal <<table, проект UC-11, UC-14>> #FFF2CC {
      id : uuid <<PK>>
      manifest_id : uuid NOT NULL <<FK>>
      seal_number : varchar(64) NOT NULL <<UQ>>
      sealed_by : uuid NOT NULL <<FK>>
      sealed_at : timestamptz NOT NULL
      intact_on_delivery : boolean
      checked_by : uuid <<FK>>
      checked_at : timestamptz
    }

    class manifest_reconciliation <<table, проект UC-15>> #FFF2CC {
      id : uuid <<PK>>
      manifest_id : uuid NOT NULL <<FK>>
      performed_by : uuid NOT NULL <<FK>>
      result : varchar(16) NOT NULL
      comment : varchar(2000)
      performed_at : timestamptz NOT NULL DEFAULT now()
      --
      CHECK result IN (MATCH, MISMATCH)
    }

    class reconciliation_discrepancy <<table, проект UC-15>> #FFF2CC {
      id : uuid <<PK>>
      reconciliation_id : uuid NOT NULL <<FK>>
      cargo_item_id : uuid NOT NULL <<FK>>
      expected_quantity : numeric(12,3) NOT NULL
      actual_quantity : numeric(12,3) NOT NULL
    }

    class supply_reservation <<table, проект UC-13>> #FFF2CC {
      id : uuid <<PK>>
      request_id : uuid NOT NULL <<FK>>
      supply_type : varchar(16) NOT NULL
      quantity : numeric(12,3) NOT NULL
      unit : varchar(16) NOT NULL
      reserved_by : uuid NOT NULL <<FK>>
      reserved_at : timestamptz NOT NULL DEFAULT now()
      --
      UNIQUE (request_id, supply_type)
      CHECK supply_type IN (WATER, FOOD, AMMO, MEDICAL, REPAIR_KIT)
    }
  }

  package "Полевые операции и финансы" {
    class trip_stage <<table, проект UC-16>> #FFF2CC {
      id : uuid <<PK>>
      request_id : uuid NOT NULL <<FK>>
      ord : integer NOT NULL
      stage_type : varchar(32) NOT NULL
      checkpoint_id : uuid <<FK>>
      planned_at : timestamptz
      confirmed_at : timestamptz
      confirmed_by : uuid <<FK>>
      --
      UNIQUE (request_id, ord)
      CHECK stage_type IN (LOADING_DONE, DEPARTURE,
        CHECKPOINT_ARRIVAL, NCR_GATE, DELIVERY)
    }

    class recovery_request <<table, проект UC-20>> #FFF2CC {
      id : uuid <<PK>>
      request_id : uuid NOT NULL <<FK>>
      incident_id : char(24)  {ObjectId документа incident, без FK}
      type : varchar(16) NOT NULL
      status : varchar(16) NOT NULL
      comment : varchar(2000)
      created_by : uuid NOT NULL <<FK>>
      created_at : timestamptz NOT NULL DEFAULT now()
      closed_at : timestamptz
      --
      CHECK type IN (EVACUATION, BACKUP, REDELIVERY, REPAIR)
      CHECK status IN (OPEN, IN_PROGRESS, CLOSED)
    }

    class financial_report <<table, проект UC-21, UC-22>> #FFF2CC {
      id : uuid <<PK>>
      request_id : uuid NOT NULL <<FK>> <<UQ>>
      revenue_caps : numeric(14,2) NOT NULL
      expense_caps : numeric(14,2) NOT NULL
      result_caps : numeric(14,2) NOT NULL
      generated_by : uuid NOT NULL <<FK>>
      generated_at : timestamptz NOT NULL DEFAULT now()
      holotape_exported_at : timestamptz
      --
      CHECK result_caps = revenue_caps - expense_caps
    }

    class financial_report_line <<table, проект UC-21>> #FFF2CC {
      id : uuid <<PK>>
      report_id : uuid NOT NULL <<FK>>
      kind : varchar(8) NOT NULL
      category : varchar(16) NOT NULL
      amount : numeric(14,2) NOT NULL
      currency : varchar(16) NOT NULL
      rate_to_caps : numeric(12,6) NOT NULL
      amount_caps : numeric(14,2) NOT NULL
      --
      CHECK kind IN (INCOME, EXPENSE)
      CHECK category IN (DELIVERY, GUARDS, MEDICS,
        SUPPLIES, NCR_FEE, OTHER)
      CHECK currency IN (CAPS, NCR_DOLLAR, DENARIUS)
    }
  }
}

' ═══════════════════════════ MongoDB 7 ═══════════════════════════════
package "MongoDB 7 — события, снимки расчётов, аудит (DC-5)" <<Database>> {
  class risk_assessment <<collection, реализовано>> #E8F5E9 {
    _id : ObjectId <<PK>>
    requestId : UUID (Binary, java-legacy)
    score : Int32 | null
    status : String  {OK | STALE | NA}
    recommendation : String
    asOf : String  {ISO-8601 от Wasteland Intel}
    threatSum : Int32
    base : Int32
    cargoFactor : Int32
    segments : Array<{segment: String, threatLevel: Int32, threats: Array<String>}>
    computedAt : Date
    _class : String  {служебное поле Spring Data}
    --
    INDEX {requestId: 1, computedAt: -1}  [проект: в коде не объявлен]
  }

  class audit_event <<collection, реализовано>> #E8F5E9 {
    _id : ObjectId <<PK>>
    type : String  {ORGANIZATION_CREATED | REQUEST_STATUS_CHANGED}
    actor : String
    organizationId : UUID | null
    userId : UUID | null
    entityType : String  [проект, RL-4]
    entityId : String  [проект, RL-4]
    details : Object
    occurredAt : Date
    _class : String
    --
    INDEX {organizationId: 1, occurredAt: -1}  [проект]
    TTL INDEX {occurredAt: 1}, expireAfterSeconds 7948800
      {92 сут — RL-5 «не менее 3 месяцев»}  [проект]
  }

  class checkpoint_log <<collection, проект UC-16…UC-18>> #FFF2CC {
    _id : ObjectId <<PK>>
    clientEventId : UUID  {id события на Pip-Boy}
    organizationId : UUID
    requestId : UUID
    tripStageId : UUID | null
    checkpointCode : String
    kind : String  {CHECKPOINT | NCR_GATE}
    occurredAt : Date
    location : {lat: Double, lon: Double}
    result : String
    delayReason : String | null
    ncrFee : {amount: Decimal128, currency: String,
      rateToCaps: Decimal128, amountCaps: Decimal128} | null
    recordedBy : UUID
    deviceId : String
    syncedAt : Date
    --
    UNIQUE INDEX {clientEventId: 1}  {повторная синхронизация идемпотентна}
    INDEX {requestId: 1, occurredAt: 1}
  }

  class incident <<collection, проект UC-19>> #FFF2CC {
    _id : ObjectId <<PK>>
    clientEventId : UUID
    organizationId : UUID
    requestId : UUID
    type : String  {ATTACK | BREAKDOWN | MEDICAL | CARGO_LOSS | DISASTER | OTHER}
    severity : String  {LOW | MEDIUM | HIGH | CRITICAL}
    occurredAt : Date
    location : {lat: Double, lon: Double}
    description : String
    participants : Array<{userId: UUID, roleCode: String,
      injured: Boolean, comment: String}>
    medical : {injuredCount: Int32,
      suppliesUsed: Array<{item: String, quantity: Int32}>} | null
    reportedBy : UUID
    deviceId : String
    syncState : String  {LOCAL | SYNCED}
    syncedAt : Date | null
    --
    UNIQUE INDEX {clientEventId: 1}
    INDEX {requestId: 1, occurredAt: -1}
    INDEX {organizationId: 1, severity: 1}
  }
}

