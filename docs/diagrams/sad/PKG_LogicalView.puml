@startuml PKG_LogicalView
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor #F5F5F5
  BorderColor #333333
}
skinparam package {
  BorderColor #333333
}

title ИС «Караваны» — Package Diagram (Logical View)\nЛогические пакеты по слоям (DC-1, DC-6, DC-7) и зависимости между ними

package "presentation" as presentation {
  package "Web-клиент" as webclient {
    rectangle "Интерфейс заявок\n<size:10>UC-1…UC-3, UC-7</size>" as P_REQ
    rectangle "Интерфейс управления\nорганизациями\n<size:10>UC-32</size>" as P_ORG
    rectangle "Сервисный слой клиента\n<size:10>обращения к контракту слоя</size>" as P_HTTP
  }
  package "Полевой клиент Pip-Boy" as pwa {
    rectangle "Полевые формы\n<size:10>UC-16…UC-19</size>" as P_FIELD
    rectangle "Локальная очередь\nсобытий\n<size:10>RL-1</size>" as P_QUEUE
  }
  package "Приём запросов" as restapi {
    rectangle "API заявок,\nстатусов и реестра" as P_API_REQ
    rectangle "API организаций" as P_API_ORG
    rectangle "API справочников\nмаршрутов" as P_API_REF
    rectangle "API состояния\nсервиса" as P_API_HEALTH
    rectangle "API команды, груза,\nполевых событий, финансов" as P_API_NEXT
  }
}

package "application" as application {
  package "Заявка и рейс\n<size:10>UC-1…UC-3</size>" as APP_REQUEST {
    rectangle "Создание заявки\nUC-1" as A_REQ
    rectangle "Управление статусами\nUC-2" as A_STATUS
    rectangle "Реестр рейсов\nUC-3" as A_REG
  }
  package "Маршрут и риски\n<size:10>UC-6…UC-8</size>" as APP_ROUTE {
    rectangle "Расчёт ETA\nUC-6" as A_ETA
    rectangle "Оценка риска\nUC-7, UC-8" as A_RISK
  }
  rectangle "Команда рейса\nUC-9, UC-10" as A_CREW
  rectangle "Груз и припасы\nUC-11…UC-15" as A_CARGO
  rectangle "Полевые события\nUC-16…UC-20" as A_FIELD
  rectangle "Финансовый отчёт\nUC-21, UC-22" as A_FIN
  rectangle "Пользователи и доступ\nUC-25…UC-31" as A_USERS
  package "Организации\n<size:10>UC-32…UC-34</size>" as APP_ORG {
    rectangle "Создание организации\nUC-32" as A_ORG
    rectangle "Подписки\nUC-33, UC-34" as A_SUBS
  }
}

package "domain" as domain {
  package "Заявка и рейс" as DOM_REQUEST {
    rectangle "Заявка" as D_REQ
    rectangle "Статусная модель" as D_SM
    rectangle "История статусов" as D_HIST
    rectangle "Реестр\nсрезы, сортировка, флаги" as D_REG
  }
  package "Маршрут и риски" as DOM_ROUTE {
    rectangle "Маршрут\nучастки, контрольные точки" as D_ROUTE
    rectangle "Риск\nрезультат, уровень, снимок" as D_RISK
  }
  rectangle "Организация" as D_ORG
  rectangle "Учётная запись" as D_USER
  rectangle "Событие аудита" as D_AUDIT
}

package "infrastructure" as infrastructure {
  rectangle "Хранение данных\n<size:10>оперативные данные организаций,</size>\n<size:10>рейсов, маршрутов и истории</size>" as I_PG
  package "Документные хранилища" as INFRA_MONGO {
    rectangle "Хранение снимков риска" as I_RISK
    rectangle "Журнал аудита" as I_AUDIT
  }
  package "Внешние адаптеры" as INFRA_EXT {
    rectangle "Адаптер Wasteland Intel\n<size:10>таймауты 2 с</size>" as I_WI
    rectangle "Адаптер NCR Checkpoint" as I_NCR
  }
  rectangle "Безопасность\n<size:10>аутентификация и доступ</size>" as I_SEC
}

package "Внешние системы" as external {
  rectangle "Wasteland Intel" as X_WI #EDE7F6
  rectangle "NCR Checkpoint &\nTax Terminal" as X_NCR #EDE7F6
}

presentation ..> application : \n\n**1** вызывает сценарии

application ..> domain : **4, 6** правила и сущности
' Пустые строки в начале подписи — отступ: без них подпись пересекают
' линии связей, сходящиеся к infrastructure.
application ..> infrastructure : \n\n**2, 3, 5, 7** <<access>>
' Пустые строки в конце подписи 8 — отступ: без них линия связи проходит
' по тексту «(обратный путь)».
application .up.> presentation : **8** сводка заявки\n(обратный путь)\n\n\n
infrastructure ..> domain : хранит сущности
I_WI ..> X_WI : **5** запрос угроз по участкам
I_NCR ..> X_NCR : прохождение КПП и пошлины
P_HTTP ..> restapi : команды и запросы
P_QUEUE ..> restapi : синхронизация\nпри появлении связи
P_API_REF .[#CC0000].> I_PG : отступление от DC-6

' ─── Компоненты каждого слоя — в одну строку. Две причины: подписи связей
'     между пакетами («4, 6 правила и сущности») иначе ложатся внутрь
'     прямоугольника пакета, а внутри пакетов остаются пустые провалы.
'     Порядок цепочки задаёт и порядок компонентов слева направо.
P_REQ -[hidden]r-> P_ORG
P_ORG -[hidden]r-> P_HTTP
P_HTTP -[hidden]r-> P_FIELD
P_FIELD -[hidden]r-> P_QUEUE

P_API_REQ -[hidden]r-> P_API_ORG
P_API_ORG -[hidden]r-> P_API_REF
P_API_REF -[hidden]r-> P_API_HEALTH
P_API_HEALTH -[hidden]r-> P_API_NEXT

A_REQ -[hidden]r-> A_STATUS
