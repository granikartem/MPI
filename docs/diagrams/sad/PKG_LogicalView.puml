@startuml PKG_LogicalView
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor #F5F5F5
  BorderColor #333333
}
skinparam package {
  BorderColor #333333
}

title ИС «Караваны» — Package Diagram (Logical View)\nЛогические пакеты по слоям (DC-1, DC-6, DC-7) и зависимости между ними

package "presentation" as presentation {
  package "Web-клиент (React 18)" as webclient {
    rectangle "Интерфейс заявок\n<size:10>UC-1…UC-3, UC-7</size>" as P_REQ
    rectangle "Интерфейс управления\nорганизациями\n<size:10>UC-32</size>" as P_ORG
    rectangle "HTTP-клиент\n<size:10>REST / JSON</size>" as P_HTTP
  }
  package "Полевой клиент Pip-Boy (PWA)" as pwa {
    rectangle "Полевые формы\n<size:10>UC-16…UC-19</size>" as P_FIELD
    rectangle "Локальная очередь\nсобытий\n<size:10>RL-1</size>" as P_QUEUE
  }
  package "REST API" as restapi {
    rectangle "API заявок,\nстатусов и реестра" as P_API_REQ
    rectangle "API организаций" as P_API_ORG
    rectangle "API справочников\nмаршрутов" as P_API_REF
    rectangle "API состояния\nсервиса" as P_API_HEALTH
    rectangle "API команды, груза,\nполевых событий, финансов" as P_API_NEXT
  }
}

package "application" as application {
  rectangle "Создание заявки\n<size:10>UC-1</size>" as A_REQ
  rectangle "Управление статусами\n<size:10>UC-2</size>" as A_STATUS
  rectangle "Реестр рейсов\n<size:10>UC-3</size>" as A_REG
  rectangle "Расчёт ETA\n<size:10>UC-6</size>" as A_ETA
  rectangle "Оценка риска\n<size:10>UC-7, UC-8</size>" as A_RISK
  rectangle "Создание организации\n<size:10>UC-32</size>" as A_ORG
  rectangle "Команда рейса\n<size:10>UC-9, UC-10</size>" as A_CREW
  rectangle "Груз и припасы\n<size:10>UC-11…UC-15</size>" as A_CARGO
  rectangle "Полевые события\n<size:10>UC-16…UC-20</size>" as A_FIELD
  rectangle "Финансовый отчёт\n<size:10>UC-21, UC-22</size>" as A_FIN
  rectangle "Пользователи и доступ\n<size:10>UC-25…UC-31</size>" as A_USERS
  rectangle "Подписки\n<size:10>UC-33, UC-34</size>" as A_SUBS
}

package "domain" as domain {
  rectangle "Заявка\n<size:10>статусная модель, история</size>" as D_REQ
  rectangle "Реестр\n<size:10>срезы, сортировка, флаги</size>" as D_REG
  rectangle "Маршрут\n<size:10>участки, контрольные точки</size>" as D_ROUTE
  rectangle "Риск\n<size:10>результат, уровень, снимок</size>" as D_RISK
  rectangle "Организация" as D_ORG
  rectangle "Учётная запись" as D_USER
  rectangle "Событие аудита" as D_AUDIT
}

package "infrastructure" as infrastructure {
  rectangle "Хранение данных\n<size:10>PostgreSQL 16, миграции Flyway</size>" as I_PG
  rectangle "Хранение снимков риска\n<size:10>MongoDB 7</size>" as I_RISK
  rectangle "Журнал аудита\n<size:10>MongoDB 7</size>" as I_AUDIT
  rectangle "Адаптер Wasteland Intel\n<size:10>REST, таймауты 2 с</size>" as I_WI
  rectangle "Адаптер NCR Checkpoint\n<size:10>REST</size>" as I_NCR
  rectangle "Безопасность\n<size:10>аутентификация, JWT</size>" as I_SEC
}

package "Внешние системы" as external {
  rectangle "Wasteland Intel" as X_WI #EDE7F6
  rectangle "NCR Checkpoint &\nTax Terminal" as X_NCR #EDE7F6
}

presentation ..> application : вызывает сценарии
application ..> domain : правила и сущности
application ..> infrastructure : <<access>>
infrastructure ..> domain : хранит сущности
I_WI ..> X_WI : REST / HTTPS, JSON
I_NCR ..> X_NCR : REST / HTTPS, JSON
P_HTTP ..> restapi : HTTPS, JSON
P_QUEUE ..> restapi : синхронизация\nпри появлении связи
P_API_REF .[#CC0000].> I_PG : отступление от DC-6

note bottom of infrastructure
  **Соответствие структуре кода** — пакеты по предметным модулям, слои внутри модуля:
  • presentation → frontend/src/pages, components, api.ts; com.karavany.request.web,
    .organization.web, .route.web, .common.health
  • application → com.karavany.request.service, .organization.service; risk.RiskService
  • domain → com.karavany.request.domain, .organization.domain, .route.domain;
    risk.RiskResult, RiskLevel, RiskAssessment; audit.AuditEvent
  • infrastructure → com.karavany.*.repository; risk.RiskAssessmentRepository,
    WastelandIntelClient; audit.AuditEventRepository; resources/db/migration
end note

legend right
  |= Обозначение |= Значение |
  | <#F5F5F5> | компонент системы |
  | <#EDE7F6> | внешняя система |
  Зависимости только сверху вниз: presentation → application →
  domain; application обращается к infrastructure (<<access>>),
  infrastructure зависит от domain.
  **Красная связь** — отступление от DC-6:
  RouteController и CheckpointController читают
  репозитории напрямую, минуя application.
  Имена логических компонентов совпадают с участниками
  диаграмм Sequence, Cooperative и State Machine (Logical View).
endlegend
@enduml
