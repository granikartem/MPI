@startuml SM_UC32_ImplementationView
!pragma layout smetana
skinparam shadowing false
skinparam state {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontName Courier
}

title UC-32 «Создать организацию» — State Machine Diagram (Implementation View)\nСостояния OrganizationService.create(...) в одной транзакции: классы, методы и HTTP-контракт

state "Команда принята" as Received
Received : command : CreateOrganizationCommand
Received : required(name), normalizeTier(tier)

state "Данные проверены" as Validated
Validated : organizationRepository.findByNameIgnoreCase(name)
Validated : userRepository.findByLoginIgnoreCase(login)
Validated : validateDispatcher(command)

state "Организация ACTIVE" as Active
Active : organization : Organization
Active : tenantKey = generateTenantKey()
Active : status = "ACTIVE"

state "Диспетчер назначен" as Dispatcher
Dispatcher : dispatcher : AppUser
Dispatcher : passwordHash(initialPassword)
Dispatcher : role = "DISPATCHER"

state "Событие записано" as Audited
Audited : event : AuditEvent
Audited : type = "ORGANIZATION_CREATED"

state "Отклонено" as Rejected #MistyRose
Rejected : @Transactional — откат

[*] --> Received : POST /api/organizations\n→ OrganizationController.create(body)\n→ OrganizationService.create(command)
Received --> Validated : [название и логин свободны,\nуровень подписки известен]
Received --> Rejected : [название или логин заняты,\nобязательное поле пусто,\nуровень подписки неизвестен]\n/ throw IllegalArgumentException
Validated --> Active : / organizationRepository.save(organization)\nINSERT INTO organization
Active --> Dispatcher : [первый диспетчер задан]\n/ userRepository.save(dispatcher)\nINSERT INTO app_user
Active --> Audited : [первый диспетчер не задан] (альт. 6а)\n/ auditEventRepository.save(event)
Dispatcher --> Audited : / auditEventRepository.save(event)\ndb.audit_event.insertOne(...)
Active --> Rejected : DataIntegrityViolationException\n(uq_organization_name_ci)
Dispatcher --> Rejected : DataIntegrityViolationException\n(uq_app_user_login_ci)
Audited --> [*] : commit → OrganizationResponse.from(result)\n→ HTTP 201 Created
Rejected --> [*] : handleBadRequest / handleConflict\n→ HTTP 400 ErrorResponse

legend right
  Подпись перехода: событие [сторожевое условие] / эффект.
  Указаны классы, методы и имена аргументов; полные списки
  параметров конструкторов и запросов не приводятся.
  Все состояния проходятся внутри одного вызова
  OrganizationService.create(...) с @Transactional.
endlegend
@enduml
