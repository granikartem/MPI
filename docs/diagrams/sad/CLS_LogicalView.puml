@startuml CLS_LogicalView
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
  FontName Arial
}
skinparam enum {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontName Arial
}
skinparam classFontSize 12
skinparam classAttributeFontSize 11
hide circle
hide empty members

title ИС «Караваны» — Class Diagram (Logical View)\nЛогические компоненты по слоям диаграммы пакетов и доменная модель; без классов реализации, аннотаций и хранилищ

package "presentation" as PRES #FDFDFD {
  class "Интерфейс заявок" as P_REQ <<компонент>> #F5F5F5 {
    форма создания заявки
    реестр рейсов и карточка рейса
    смена статуса и пересчёт риска
  }
  class "Интерфейс управления\nорганизациями" as P_ORG <<компонент>> #F5F5F5 {
    форма создания организации
    список организаций
  }
  class "HTTP-клиент" as P_HTTP <<компонент>> #F5F5F5 {
    обращения к контракту слоя
  }
  class "API заявок,\nстатусов и реестра" as P_API_REQ <<контракт>> #F5F5F5 {
    приём команд и запросов
    границы транзакции, результат или отказ
  }
  class "API организаций" as P_API_ORG <<контракт>> #F5F5F5 {
    приём команд и запросов
  }
  class "API справочников\nмаршрутов" as P_API_REF <<контракт>> #F5F5F5 {
    чтение маршрутов\nи контрольных точек
  }
}

package "application" as APP #FDFDFD {
  class "Создание заявки" as A_REQ <<компонент>> #F5F5F5 {
    UC-1
    собирает рейс: маршрут, время в пути,
    оценка риска, стартовая история
  }
  class "Управление статусами" as A_STATUS <<компонент>> #F5F5F5 {
    UC-2
    проверяет допустимость перехода
    и записывает историю
  }
  class "Реестр рейсов" as A_REG <<компонент>> #F5F5F5 {
    UC-3
    срезы, фильтры, сортировка,
    признаки внимания
  }
  class "Расчёт ETA" as A_ETA <<компонент>> #F5F5F5 {
    UC-6
    время в пути по длинам участков
  }
  class "Оценка риска" as A_RISK <<компонент>> #F5F5F5 {
    UC-7, UC-8
    сводит угрозы участков и ценность груза
    в оценку и рекомендацию
  }
  class "Создание организации" as A_ORG <<компонент>> #F5F5F5 {
    UC-32
    провижининг организации
    и первого диспетчера
  }
}

package "domain" as DOM #FDFDFD {
  class "Организация" as ORG #F5F5F5 {
    ключ пространства данных : текст
    название : текст {уникально}
    уровень подписки : текст {базовый / стандартный / расширенный}
    состояние : текст {активна при создании}
    создана : момент времени
  }

  class "Учётная запись" as USER #F5F5F5 {
    имя : текст
    логин : текст {уникален}
    пароль : не хранится в открытом виде
    роль : Роль участника
    канал связи : текст
    активна : признак
  }

  class "Заявка" as REQ #F5F5F5 {
    пункт отправления : текст
    пункт назначения : текст
    дата отправки : дата
    описание груза : текст
    ценность груза : число {крышки}
    время в пути : число {часы, FR-5}
    значение риска : число {0..100, может быть не задано}
    актуальность риска : текст {актуальна / на устаревших данных /
    не рассчитана}
    рекомендация : текст {FR-8}
    статус : Статус рейса
    создана : момент времени
  }

  class "История статусов" as HIST #F5F5F5 {
    из какого статуса : Статус рейса {не задан у стартовой записи}
    в какой статус : Статус рейса
    роль инициатора : Роль участника
    имя инициатора : текст
    причина : текст {обязательна при фиксации задержки}
    когда произошло : момент времени
  }

  class "Статусная модель" as SM #F5F5F5 {
    разрешённые переходы : список
    роли, которым переход доступен
    когда причина обязательна
    какие статусы финальные
  }

  enum "Статус рейса" as STATUS #F5F5F5 {
    Черновик
    Готов к отправке
    В пути
    Задержка
    Доставлен
    Закрыт
    Отменён
  }

  enum "Роль участника" as ROLE #F5F5F5 {
    Диспетчер караванов
    Караван-мастер
    Система
  }

  class "Маршрут" as ROUTE #F5F5F5 {
    код : текст {уникален}
    название : текст
    шаблон : признак {общий для платформы}
  }

  class "Участок маршрута" as SEG #F5F5F5 {
    порядок в маршруте : число
    протяжённость : число {км}
    /ключ участка : текст {«откуда — куда», производное}
  }

  class "Контрольная точка" as CP #F5F5F5 {
    код : текст {уникален}
    название : текст
  }

  class "Снимок оценки риска" as RISK #F5F5F5 {
    значение : число {не задано, если оценка не рассчитана}
    актуальность : текст {актуальна / на устаревших данных /
    не рассчитана}
    рекомендация : текст
    дата сведений об угрозах : момент времени
    сумма уровней угроз : число
    базовая оценка маршрута : число
    надбавка за ценность груза : число
    разбор по участкам : список
    рассчитан : момент времени
  }

  enum "Уровень риска" as LEVEL #F5F5F5 {
    Н/Д
    Низкий
    Средний
    Высокий
    Критический
  }

  class "Срез реестра" as REG #F5F5F5 {
    область среза : текст
    сортировка : текст
    предел выдачи : число
    показано : число
    срез усечён : признак
    сводка по статусам и рискам
  }

  class "Событие аудита" as AUDIT #F5F5F5 {
    тип : текст {создание организации / смена статуса}
    инициатор : текст
    организация
    учётная запись
    подробности : набор значений
    когда произошло : момент времени
  }
}

package "infrastructure" as INFRA #FDFDFD {
  class "Хранение данных" as I_PG <<компонент>> #F5F5F5 {
    оперативные данные организаций,
    рейсов, маршрутов и истории
  }
  class "Хранение снимков риска" as I_RISK <<компонент>> #F5F5F5 {
    снимок каждого расчёта риска
  }
  class "Журнал аудита" as I_AUDIT <<компонент>> #F5F5F5 {
    события изменения данных (RL-4, RL-5)
  }
  class "Адаптер\nWasteland Intel" as I_WI <<компонент>> #F5F5F5 {
    запрос угроз по ключам участков
    таймауты и отказ источника
  }

  class "Отчёт об угрозах" as REPORT <<контракт источника>> #EDE7F6 {
    дата актуальности : момент времени
  }

  class "Угроза участка" as THREAT <<контракт источника>> #EDE7F6 {
    ключ участка : текст
    уровень опасности : число
    виды угроз : список текстов
  }
}

package "внешние системы" as EXT #FDFDFD {
  class "Wasteland Intel" as WI <<внешняя система>> #EDE7F6 {
  }
}

' ─── Правила взаимодействия слоёв (DC-6) ─────────────────────────────
P_HTTP ..> P_API_REQ : REST / JSON
P_HTTP ..> P_API_ORG : REST / JSON
P_HTTP ..> P_API_REF : REST / JSON
P_REQ ..> P_HTTP
P_ORG ..> P_HTTP

P_API_REQ ..> A_REQ
P_API_REQ ..> A_STATUS
P_API_REQ ..> A_REG
P_API_ORG ..> A_ORG
P_API_REF ..> I_PG : <<отступление от DC-6>>\nчтение справочников в обход application

A_REQ ..> A_ETA
A_REQ ..> A_RISK
A_REQ ..> A_STATUS

' ─── application → domain ────────────────────────────────────────────
A_REQ ..> REQ : собирает рейс
A_STATUS ..> SM : проверяет переход
A_STATUS ..> HIST : пишет историю
A_REG ..> REG : формирует срез
A_ETA ..> ROUTE : суммирует участки
A_RISK ..> RISK : формирует снимок оценки
A_RISK ..> LEVEL : выводит уровень риска
A_ORG ..> ORG : создаёт организацию
A_ORG ..> USER : создаёт первого диспетчера

' ─── application → infrastructure ────────────────────────────────────
A_REQ ..> I_PG : <<access>>
A_STATUS ..> I_PG : <<access>>
A_STATUS ..> I_AUDIT : <<access>>
A_REG ..> I_PG : <<access>>
A_RISK ..> I_RISK : <<access>>
A_RISK ..> I_WI : <<access>>
A_ORG ..> I_PG : <<access>>
A_ORG ..> I_AUDIT : <<access>>

' ─── infrastructure → domain и внешние системы ───────────────────────
I_PG ..> REQ : хранит сущности
I_RISK ..> RISK : хранит снимки
I_AUDIT ..> AUDIT : хранит события
I_WI ..> WI : REST / HTTPS
I_WI ..> REPORT : разбирает ответ
REPORT "1" o-- "1..*" THREAT : угрозы по участкам
THREAT ..> SEG : сопоставляется по ключу участка
REPORT ..> RISK : сведения об угрозах\nучаствуют в расчёте (FR-6, FR-7)

' ─── Доменная модель ─────────────────────────────────────────────────
ORG "1" o-- "0..*" USER : сотрудники организации
ORG "1" o-- "0..*" REQ : рейсы организации (FR-23, FR-24)
REQ "0..*" --> "0..1" ROUTE : выполняется по маршруту
ROUTE "1" *-- "1..*" SEG : участки в порядке следования
SEG "0..*" --> "1" CP : начало участка
SEG "0..*" --> "1" CP : конец участка
REQ "1" *-- "1..*" HIST : история переходов (FR-3)
REQ ..> STATUS : текущий статус
HIST ..> STATUS : из какого в какой
HIST ..> ROLE : роль инициатора
SM ..> STATUS : область определения переходов
SM ..> ROLE : кому переход доступен
REQ "1" .. "0..*" RISK : снимок каждого расчёта
REQ ..> LEVEL : уровень выводится из значения\nи актуальности при чтении (UC-3)
REG "1" o-- "0..*" REQ : строки среза
ORG "1" .. "0..*" AUDIT : события организации
HIST "0..1" .. "0..1" AUDIT : переход дублируется событием журнала

note as N_LAYERS
  **Правила взаимодействия слоёв (DC-6)**
  • presentation обращается к application только
    через контракт API; риск и статусы сам не считает
  • application держит сценарии прецедентов, работает
    с domain и обращается к infrastructure как <<access>>
  • domain не знает ни о слоях выше, ни о хранилищах
  • infrastructure скрывает выбор хранилища и протокол
    обращения к внешним системам
  **Отступление:** API справочников маршрутов читает
  хранилище напрямую, минуя application.
end note


legend right
  |= Обозначение |= Значение |
  | <#F5F5F5> | логический компонент слоя или класс домена |
  | <#EDE7F6> | «внешняя система» и контракт её данных |
  **Уровень описания.** Слои и компоненты, их зоны ответственности
  и правила взаимодействия; классы домена — со свойствами в деловых
  типах. Фактические классы, сигнатуры, аннотации и хранилища —
  на CLS_ImplementationView.
  **Имена слоёв и компонентов** дословно совпадают с диаграммой
  пакетов PKG_LogicalView и с участниками диаграмм Sequence,
  Cooperative и State Machine в Logical View.
  **Деловые типы полей:** ""текст"", ""число"", ""дата"",
  ""момент времени"", ""признак"", ""список"".
  Производное поле помечено ""/"".
  **Типы связей:** ""*--"" композиция, ""o--"" агрегация,
  ""-->"" ассоциация, "".."" связь по значению,
  ""..>"" зависимость (кратности не указываются).
  **Трассировка:** FR-3 (история), FR-5 (ETA), FR-6 (Wasteland Intel),
  FR-7 (risk_score), FR-8 (рекомендация), FR-23 и FR-24 (организация
  и изоляция её данных), RL-4 и RL-5 (журнал аудита),
  DC-6 (слоистая архитектура).
endlegend
@enduml
