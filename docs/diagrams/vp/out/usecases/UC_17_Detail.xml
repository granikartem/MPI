ь принадлежность точки и порядок (шаг 5).&#10;UC-17.4 — Сохранить отметку в CheckpointLog (шаги 4, 6).&#10;Точки расширения и условия:&#10;UC-17 → UC-16 / EP-1: Выбрано событие прибытия на контрольную точку маршрута.&#10;UC-17.5 → UC-17 / EP-6: Связи нет; отметка передаётся с исходными временем и координатами (альт. 5б).&#10;UC-17.6 → UC-17 / EP-7: Точка не принадлежит маршруту или нарушен порядок (альт. 5а)." /></ModelProperties></Model></ChildModels></Model><Model id="STextend00000000" modelType="Stereotype" name="extend"><ModelProperties><StringProperty name="name" value="extend" /><StringProperty name="baseType" value="Extend" /></ModelProperties></Model><Model id="STinclude0000000" modelType="Stereotype" name="include"><ModelProperties><StringProperty name="name" value="include" /><StringProperty name="baseType" value="Include" /></ModelProperties></Model></Models><Diagrams><Diagram id="D_UC_17_Detail00" name="UC_17_Detail" diagramType="UseCaseDiagram"><DiagramProperties><BooleanProperty name="autoFitShapesSize" value="false" /><BooleanProperty name="alignToGrid" value="false" /><BooleanProperty name="gridVisible" value="false" /><BooleanProperty name="showStereotypes" value="true" /></DiagramProperties><Shapes><Shape id="Stitle0000000000" shapeType="TextBox" x="733" y="56" width="427" height="26" zorder="2" model="Mtitle0000000000" name="UC-17. Отметить прохождение контрольной точки"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty name="requestResetCaptionSize" value="true" /></DiagramElementProperties><Caption visible="true" side="Center" x="0" y="0" width="427" height="26" /></Shape><Shape id="S_sys00000000000" shapeType="System" x="190" y="99" width="1745" height="429" zorder="12" model="M_sys00000000000" name="ИС «Караваны»"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty name="requestResetCaptionSize" value="true" /></DiagramElementProperties><Eleme