otype" name="include"><ModelProperties><StringProperty name="name" value="include" /><StringProperty name="baseType" value="Include" /></ModelProperties></Model><Model id="STextend00000000" modelType="Stereotype" name="extend"><ModelProperties><StringProperty name="name" value="extend" /><StringProperty name="baseType" value="Extend" /></ModelProperties></Model></Models><Diagrams><Diagram id="D_UC_8_Detail000" name="UC_8_Detail" diagramType="UseCaseDiagram"><DiagramProperties><BooleanProperty name="autoFitShapesSize" value="false" /><BooleanProperty name="alignToGrid" value="false" /><BooleanProperty name="gridVisible" value="false" /><BooleanProperty name="showStereotypes" value="true" /></DiagramProperties><Shapes><Shape id="Stitle0000000000" shapeType="TextBox" x="441" y="56" width="456" height="26" zorder="2" model="Mtitle0000000000" name="UC-8. Получить рекомендацию по охране и припасам"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty name="requestResetCaptionSize" value="true" /></DiagramElementProperties><Caption visible="true" side="Center" x="0" y="0" width="456" height="26" /></Shape><Shape id="S_sys00000000000" shapeType="System" x="197" y="246" width="1052" height="413" zorder="11" model="M_sys00000000000" name="ИС «Караваны»"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty name="requestResetCaptionSize" value="true" /></DiagramElementProperties><ElementFont name="Arial" size="11" style="0" color="Cr:51,51,51,255" /><Line color="Cr:51,51,51,255" weight="1.0" transparency="0" cap="0"><Stroke /></Line><Caption visible="true" side="Center" x="0" y="0" width="1052" height="413" /><ChildShapes><Shape id="S_UC700000000000" shapeType="UseCase" x="928" y="288" width="256" height="58" zorder="3" model="M_UC700000000000" name="UC-7. Рассчитать risk_score"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty na