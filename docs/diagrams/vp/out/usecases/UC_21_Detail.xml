/ModelProperties></Model></FromEnd><ToEnd><Model composite="true" modelType="AssociationEnd" id="M_a_Dispatcherx5" name=""><ModelProperties><StringProperty name="name" value="" /><ModelRefProperty name="EndModelElement"><ModelRef id="M_UC220000000000" /></ModelRefProperty><StringProperty name="aggregationKind" value="None" /></ModelProperties></Model></ToEnd></Model><Model id="M_legend00000000" modelType="NOTE"><ModelProperties><HTMLProperty name="documentation" plainTextValue="Части основного потока (include):&#10;UC-21.1 — Найти и выбрать рейс для отчёта (шаг 1).&#10;UC-21.2 — Собрать доходы, расходы, припасы и пошлины рейса (шаг 2).&#10;UC-21.3 — Привести суммы к крышкам по применяемому курсу (шаг 3).&#10;UC-21.4 — Рассчитать итоговый финансовый результат (шаг 4).&#10;UC-21.5 — Сохранить отчёт с расшифровкой исходных сумм (шаг 5).&#10;Точки расширения и условия:&#10;UC-22 → UC-21 / EP-1: Отчёт сформирован; диспетчер решил выгрузить его на внешний носитель.&#10;UC-21.6 → UC-21 / EP-2: Не хватает данных для подтверждённого итогового отчёта (альт. 2а).&#10;UC-21.7 → UC-21 / EP-3: Для исходной валюты не указан курс пересчёта (альт. 3а).&#10;Нужный отчёт находится через UC-21.1: отчёт строится по выбранному рейсу,&#10;поэтому поиск отчёта — это поиск рейса в реестре (UC-3) или в архиве (UC-4)." /></ModelProperties></Model></ChildModels></Model><Model id="STextend00000000" modelType="Stereotype" name="extend"><ModelProperties><StringProperty name="name" value="extend" /><StringProperty name="baseType" value="Extend" /></ModelProperties></Model><Model id="STinclude0000000" modelType="Stereotype" name="include"><ModelProperties><StringProperty name="name" value="include" /><StringProperty name="baseType" value="Include" /></ModelProperties></Model></Models><Diagrams><Diagram id="D_UC_21_Detail00" name="UC_21_Detail" diagramType="UseCaseDiagram"><DiagramProperties><BooleanProperty name="autoFitShapesSize" value="false" /><BooleanProperty name="alignToGrid" value="false" /