 рамкой —&#10;  то, что выполняется уже вне транзакции. Заметки — свёрнутые участники." /></ModelProperties></Model></Models><Diagrams><Diagram id="D_SEQ_UC2_Implem" name="SEQ_UC2_ImplementationView" diagramType="InteractionDiagram"><DiagramProperties><BooleanProperty name="showSequenceNumbers" value="false" /></DiagramProperties><Shapes><Shape id="Stitle0000000000" shapeType="TextBox" x="2191" y="65" width="703" height="52" zorder="1" model="Mtitle0000000000" name="UC-2 «Управлять статусами заявки» — Sequence Diagram (Implementation View)&#10;Реальные классы, методы и HTTP-контракт перехода статуса"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty name="requestResetCaptionSize" value="true" /></DiagramElementProperties><Caption visible="true" side="Center" x="0" y="0" width="703" height="52" /></Shape><Shape id="S100000000000000" shapeType="InteractionActor" x="47" y="219" width="142" height="2482" zorder="10" model="M100000000000000" name="Диспетчер /&#10;караван-мастер"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty name="requestResetCaptionSize" value="true" /></DiagramElementProperties><Caption visible="true" side="Center" x="0" y="0" width="142" height="2482" /><FillColor type="1" color="Cr:245,245,245,255" transparency="0" style="0" /></Shape><Shape id="S200000000000000" shapeType="InteractionLifeLine" x="484" y="219" width="225" height="2482" zorder="14" model="M200000000000000" name="modal:StatusModal.tsx"><DiagramElementProperties><BooleanProperty name="requestResetCaption" value="true" /><BooleanProperty name="requestResetCaptionSize" value="true" /></DiagramElementProperties><Caption visible="true" side="Center" x="0" y="0" width="225" height="2482" /><FillColor type="1" color="Cr:245,245,245,255" transparency="0" style="0" /></Shape><Shape id="S300000000000000" shapeType="InteractionLifeLine" x="952" y="219" width="236" height="2482" zorder="16" m