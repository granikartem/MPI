@startuml UC_7_Activity
title Диаграмма активности: UC-7 — Рассчитать risk_score

start

:Система формирует запрос к API
Wasteland Intel (список контрольных точек);

if (Wasteland Intel\nдоступен?) then (Да)
  :Wasteland Intel возвращает
  данные об угрозах по участкам;

  if (Данные актуальны\n(< 24 часов)?) then (Да)
    :Система агрегирует
    данные об угрозах;
  else (Нет)
    :Система агрегирует данные,
    помечает как «устаревшие»;
    :Система предупреждает
    диспетчера;
  endif

  :Система вычисляет
  базовый risk_score;

  :Система применяет коэффициент
  ценности груза;

  :Система сохраняет итоговый
  risk_score в заявке;

  :Система формирует рекомендацию
  по охране и припасам (UC-8);

else (Нет)
  :Система устанавливает
  risk_score = «Н/Д»;
  :Система помечает заявку
  «risk_score требует пересчёта»;
  :Система уведомляет диспетчера;
endif

stop

@enduml
